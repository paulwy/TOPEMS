{
  "openapi": "3.0.1",
  "info": {
    "title": "TOPEMS 模块化单体 API 文档",
    "version": "v1.3",
    "description": "TOPEMS 模块化单体（:8099）核心 API 文档。2026-09-24 P1-2 生成，覆盖已验证的核心端点；全量 31 模块端点详见各模块源码（svc/server/src/modules）。统一响应格式：ApiResponse（code/success/data/message/timestamp）。",
    "license": {
      "name": "Internal"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8099",
      "description": "本地模块化单体"
    }
  ],
  "paths": {
    "/api/server/health": {
      "get": {
        "summary": "健康检查",
        "tags": [
          "平台"
        ],
        "responses": {
          "200": {
            "description": "健康状态聚合",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
