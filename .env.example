# TOPEMS 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==============================================================================
# 数据库配置
# ==============================================================================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems
DB_USER=topems
DB_PASSWORD=topems_secret

# ==============================================================================
# Redis 配置
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# JWT 配置
# ==============================================================================
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=86400
JWT_EXPIRY_HOURS=24

# ==============================================================================
# 服务端口配置 (统一端口规范)
# ==============================================================================

# 平台核心服务 (8000-8009)
IAM_PORT=8000
CORE_PORT=8000
DOC_PORT=8001
PM_PORT=8002
NOTIFICATION_PORT=8003
INTEGRATION_PORT=8004
PORTAL_PORT=8005
FLOW_PORT=8006

# 业务服务 (8010-8029)
ERP_PORT=8010
HRM_PORT=8011
CRM_PORT=8012
RS_PORT=8020

# 制造服务 (8030-8039)
MES_PORT=8030
PDM_PORT=8031

# 供应链服务 (8040-8049)
SCM_PORT=8040
SRM_PORT=8041
WMS_PORT=8042

# 质量与实验室服务 (8050-8059)
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
GIS_PORT=8054
IM_PORT=8055
MOBILE_PORT=8056

# 分析与扩展服务 (8060-8069)
BI_PORT=8060
REPORT_PORT=8061
AI_PORT=8062
MONITOR_PORT=8064

# ==============================================================================
# 下游服务 URL 配置
# ==============================================================================
FILE_SERVICE_URL=http://localhost:8050
AI_SERVICE_URL=http://localhost:8062

# ==============================================================================
# 文件服务配置
# ==============================================================================
STORAGE_LOCAL_PATH=./storage/files
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10
MAX_FILE_SIZE=104857600

# ==============================================================================
# AI 服务配置 (Ollama 本地 AI)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# 可选: 云端 AI 配置 (OpenAI/通义等)
# ==============================================================================
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# ==============================================================================
# 邮件服务配置
# ==============================================================================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=topmap@163.com
SMTP_PASSWORD=BMyf23ZqRburuhCv
SMTP_FROM_ADDRESS=topmap@163.com

# ==============================================================================
# 其他配置
# ==============================================================================
ENVIRONMENT=development
RUST_LOG=info

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173