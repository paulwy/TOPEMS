# TOPEMS Project Root Environment Configuration
# Copy this file to .env and modify as needed

# Global Database Configuration
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems

# Global Redis Configuration
REDIS_URL=redis://localhost:6379

# Global Log Level
RUST_LOG=info

# Authentication Configuration
# JWT_SECRET must be at least 32 characters long
# Generate using: openssl rand -base64 32
JWT_SECRET=<your-secure-jwt-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<your-secure-refresh-secret-at-least-32-characters>
JWT_EXPIRES_IN=7200

# Permission Configuration
# Enable/disable permission check (for development only)
PERMISSION_CHECK_ENABLED=true

# Note: Each service also has its own .env file in its backend directory
# for service-specific configurations like ports, API keys, etc.
