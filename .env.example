# TOPEMS 统一环境配置
# 复制此文件为 .env 并根据需要修改

# ==================== 应用环境 ====================
APP_ENV=development
RUST_LOG=info

# ==================== 数据库配置 ====================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/topems_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== 认证配置 ====================
JWT_SECRET=topems-dev-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24
REFRESH_SECRET=topems-dev-refresh-secret-change-in-production

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8020

# ==================== AI 配置 ====================
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ==================== 文件存储 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# ==================== 邮件配置 ====================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=topems@localhost

# ==================== 服务端口（各服务可覆盖） ====================
# IAM: 8001, RS: 8002, LIMS: 8003, QMS: 8004, MES: 8005
# ERP: 8006, SCM: 8007, WMS: 8008, CRM: 8009, HRM: 8010
# GIS: 8011, BI: 8012, EHS: 8013, PDM: 8014, SRM: 8015
# IM: 8016, AI: 8017, MOBILE: 8018, INTEGRATION: 8019, PORTAL: 8020
