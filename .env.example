# TOPEMS 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ================================================
# 数据库配置
# ================================================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems

# ================================================
# JWT 认证配置
# ================================================
JWT_SECRET=topems-jwt-secret-key-must-be-at-least-32-characters-long-for-hs256
REFRESH_SECRET=topems-jwt-refresh-secret-key-must-be-at-least-32-characters-long

# ================================================
# 服务端口配置
# ================================================
IAM_PORT=8000
DOC_PORT=8001
HRM_PORT=8011
AI_PORT=8013
FILE_PORT=8055
MAIL_PORT=8054

# ================================================
# 文件服务配置
# ================================================
FILE_SERVICE_URL=http://localhost:8055
STORAGE_LOCAL_PATH=./storage/files

# ================================================
# AI 服务配置 (Ollama 本地 AI)
# ================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# ================================================
# 可选: 云端 AI 配置 (OpenAI/通义等)
# ================================================
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# ================================================
# 邮件服务配置
# ================================================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=topmap@163.com
SMTP_PASSWORD=BMyf23ZqRburuhCv
SMTP_FROM_ADDRESS=topmap@163.com

# ================================================
# 日志配置
# ================================================
RUST_LOG=info

# ================================================
# 数据库搜索路径
# ================================================
# SEARCH_PATH=service_schema, shared, public
