# TOPEMS 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==============================================================================
# 数据库配置
# ==============================================================================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems
DB_HOST=localhost
DB_PORT=5432
DB_USER=topems
DB_PASSWORD=topems_secret
DB_NAME=topems

# ==============================================================================
# Redis 配置
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# JWT 配置
# ==============================================================================
# JWT_SECRET 必须至少32个字符
JWT_SECRET=topems-jwt-secret-key-must-be-at-least-32-characters-long-for-hs256
# JWT_REFRESH_SECRET 必须至少32个字符
JWT_REFRESH_SECRET=topems-jwt-refresh-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=86400

# ==============================================================================
# 服务端口配置
# ==============================================================================
# 平台核心服务
IAM_PORT=8000
DOC_PORT=8001
PM_PORT=8002
NOTIFICATION_PORT=8003
INTEGRATION_PORT=8004
PORTAL_PORT=8005
FLOW_PORT=8006

# 业务服务
ERP_PORT=8010
HRM_PORT=8011
CRM_PORT=8012
AI_PORT=8013
RS_PORT=8020
LIMS_PORT=8022
PDM_PORT=8023
MES_PORT=8030
QMS_PORT=8031
EHS_PORT=8032
SCM_PORT=8040
SRM_PORT=8041
WMS_PORT=8042
GIS_PORT=8050
IM_PORT=8051
BI_PORT=8052
REPORT_PORT=8053
MAIL_PORT=8054
MOBILE_PORT=8055

# ==============================================================================
# 前端配置
# ==============================================================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# ==============================================================================
# 日志配置
# ==============================================================================
RUST_LOG=info
LOG_LEVEL=info

# ==============================================================================
# 其他配置
# ==============================================================================
# 环境: development, staging, production
ENVIRONMENT=development

# CORS 允许的源
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 文件上传路径
UPLOAD_PATH=./uploads

# 最大上传文件大小 (MB)
MAX_UPLOAD_SIZE=10