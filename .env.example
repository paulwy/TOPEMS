# TOPEMS 环境配置示例 (V66.2 / Shared Bootstrap V2 28/28 = 100%)
# 复制此文件为 .env 并根据实际情况修改
# ==============================================================================
# V66.2 Shared Bootstrap V2 说明：
#   所有业务服务 main.rs 中 ServiceConfig.port_env_var 即引用下方 *_PORT 变量。
#   单一真相源 = config/ports.env（请先改 ports.env，再 bash scripts/sync-ports.sh）
#   复杂度模式 A（10）/ B（13）/ C（5）参见 docs/architecture/overview.md
# ==============================================================================

# ==============================================================================
# 数据库配置
# ==============================================================================
# ⚠️ 禁止把生产 DSN 写成本变量的默认值（2026-11-18 生产写入事故根因）。
#   本文件只允许出现本地开发库连接串；DATABASE_URL 缺失时进程必须 fail-fast，
#   不得静默回退到任何生产库。生产连接串由部署单元显式注入。
#   ⚠️ 不要在这里写口令：本机默认走 socket 认证（当前 OS 用户），需要口令请自行导出。
DATABASE_URL=postgres:///topems
# 口径统一（AR-05）：DATABASE_URL 一律使用【干净连接串】，不要在此内嵌
#   ?options=-csearch_path=... 。运行时 search_path 由连接池 after_connect 统一执行
#   SELECT set_config('search_path', '<SEARCH_PATH>', false) 设置（唯一权威来源，见
#   lib/shared-db/src/database/mod.rs 与 lib/shared-bootstrap 的 pool builder）；
#   各服务 schema 归属由 SEARCH_PATH 环境变量决定（默认 "rs, erp, public"）。
# 唯一例外：mes 在线编译 / sqlx prepare 需要在编译期静态绑定 search_path，须临时追加
#   ?options=-csearch_path=mes,public（mes 表在 mes schema，缺省会报 relation does not exist）；
#   推荐通过 scripts/topems.sh mes-guard --prepare / --skip-compile 自动处理（脚本内置该参数），
#   切勿把它写回运行时 DATABASE_URL。
# 迁移/DDL owner 池（服务池 topems_app 无 DDL 权限；迁移工具/CI 另配）
# 门禁口径：pre-commit `rls-permissions` 按 MIGRATE_URL（回退 DATABASE_URL）连接串
#   中的实际运行角色校验关键表 SELECT 与默认权限，不再写死 topems_app。
MIGRATE_URL=postgres://topems@localhost:5432/topems
# 迁移账本校验（pre-push `ledger-ddl-drift`）的目标库 DSN。
#   默认即可跑通，无需临时 export：本机先跑一次
#     bash scripts/migration/build-drift-gate-db.sh
#   重建只读夹具库 topems_gate（迁移链完整 + 最小 SELECT 授权），下面这行直接可用。
#   解析顺序（前者优先，均无则门禁 fail-closed）：
#     1) 进程环境 MIGRATION_DRIFT_DB_URL
#     2) .env 的 MIGRATION_DRIFT_DB_URL（本变量，默认指向夹具库）
#     3) 进程环境 DATABASE_URL（外层 shell / ~/.zshrc 等导出）
#     4) .env 的 MIGRATE_URL
#   专用变量优先于通用 DATABASE_URL：DATABASE_URL 常是某个 shell 里遗留的通用连接，
#   不应覆盖这里显式配置的门禁目标库。
#   目标库必须是由迁移链建起来的库（有 _sqlx_migrations 账本）。若命中的是 pg_dump
#   结构副本（只同步 schema、没跑迁移），该库天然没有账本，门禁会报「账本为空」。
#   此时请重建夹具库并指向它，不要去放宽判定。
#   角色 topems_gate 只授 USAGE(public,finance,mes,mobile) 与
#   _sqlx_migrations / core_permissions / core_role_permissions / core_roles 的 SELECT。
#   口令按本机实际情况补在 .env（勿提交本文件）。
MIGRATION_DRIFT_DB_URL=postgres://topems_gate@127.0.0.1:5432/topems_gate
# 测试专用 DSN（可选但推荐）：#[sqlx::test] 会按 DATABASE_URL 创建临时测试库，
#   若 DATABASE_URL/MIGRATE_URL 指向的角色没有 CREATEDB（如 topems_prod），
#   测试会在 setup 阶段报 42501 permission denied to create database。
#   这里填一个带 CREATEDB 的专用角色（不要加 BYPASSRLS，否则 RLS 用例会被绕过），
#   pre-push 的 cargo-test-workspace 会优先使用本节，并同时喂给 DATABASE_URL
#   （优先级：进程环境 > 本节 TEST_DATABASE_URL > MIGRATE_URL）。
#   建角色：psql -d postgres -c "CREATE ROLE topems_test_runner LOGIN CREATEDB"
#   建库并同步结构（测试库需与迁移后的开发库一致）：
#     createdb -O topems_test_runner topems_test_runner
#     pg_dump --schema-only --no-owner --no-privileges -d topems | psql <上面这个 DSN>
#   svc/rd 的仓库测试不带租户上下文，另需一次：
#     ALTER TABLE rs.projects NO FORCE ROW LEVEL SECURITY;  -- 在测试库执行
TEST_DATABASE_URL=postgres://topems_test_runner@localhost:5432/topems_test_runner
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems
DB_USER=topems
# 口令不写进模板：本机默认走 socket 认证；需要口令时由部署环境注入，不要提交到仓库
DB_PASSWORD=

# ---- 连接池预算（PostgreSQL max_connections=50，预算上限 45，留 5 余量）----
# 默认 max_connections=4/min=1（所有业务服务）。
# 预算明细（17 独立 pool）：
#   unified-core(核心承载 IAM/DOC/FILE/MAIL/IM/NOTICE/FLOW): 8
#   ai/portal(大屏高并发): 5 x 2 = 10
#   erp/finance/mes/scm/wms/crm/qms/pdm/hrm(主业务服务): 4 x 9 = 36
#   srm/lims/ehs/rd/analytics/gis/integration/master-data/mobile(低频): 3 x 9 = 27
# 说明：开发单服务启动时默认 4 无压力；生产请按服务分层覆盖以下 *_DB_MAX_CONNECTIONS。
# 单服务可独立覆盖：<SVC_NAME>_DB_MAX_CONNECTIONS 优先于全局 DB_MAX_CONNECTIONS。
DB_MAX_CONNECTIONS=4
CORE_DB_MAX_CONNECTIONS=8
AI_DB_MAX_CONNECTIONS=5
PORTAL_DB_MAX_CONNECTIONS=5
ERP_DB_MAX_CONNECTIONS=4
FINANCE_DB_MAX_CONNECTIONS=4
MES_DB_MAX_CONNECTIONS=4
SCM_DB_MAX_CONNECTIONS=4
WMS_DB_MAX_CONNECTIONS=4
CRM_DB_MAX_CONNECTIONS=4
QMS_DB_MAX_CONNECTIONS=4
PDM_DB_MAX_CONNECTIONS=4
HRM_DB_MAX_CONNECTIONS=4

# ==============================================================================
# Redis 配置
# ==============================================================================
# 用途：
#   1. 分布式缓存 L2 层（与各服务进程内 moka L1 配合，跨实例共享）
#   2. 会话存储、限流计数器、消息队列后端
# 未配置 REDIS_URL 时，各服务自动降级为纯进程内缓存（moka），不影响启动
# 详见：docs/development/backend/code-standards.md 缓存章节
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# 事件总线配置
# ==============================================================================
# 事件总线模式（V321 默认改为 stream）：
#   stream（默认）：Redis Stream，消息持久化，支持 ACK + 死信队列（DLQ），适合生产环境
#   pubsub：Redis Pub/Sub，消息不持久化，适合开发环境或向后兼容
# 注意：Stream 模式初始化失败时会自动降级到 Pub/Sub 模式，确保服务正常启动
# 详见：lib/shared-event/src/event/stream_publisher.rs, stream_subscriber.rs
EVENT_BUS_MODE=stream

# ==============================================================================
# JWT 配置
# ==============================================================================
# ---- JWT 密钥安全要求 ----------------------------------------------------
# 生产部署 / 真实环境必须替换！长度 ≥32 字符，不要使用任何弱默认值：
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export JWT_REFRESH_SECRET=$(openssl rand -hex 32)
# -------------------------------------------------------------------------
JWT_SECRET=<SET_YOUR_OWN_STRONG_SECRET_AT_LEAST_32_CHARS__REQUIRED>
JWT_REFRESH_SECRET=<SET_YOUR_OWN_REFRESH_SECRET_AT_LEAST_32_CHARS__MUST_BE_DIFFERENT>
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=86400
JWT_EXPIRY_HOURS=24

# ---- IAM 注册开关 (P1-3) -------------------------------------------------
# 自助注册 POST /api/core/iam/auth/register 默认关闭（403）。
# 仅在确有公开注册需求时显式设为 true/1；开启后新账号落 status=pending，
# 须管理员激活并分配角色/租户后方可登录（登录仅放行 active）。
REGISTER_ENABLED=false

# ---- 初始管理员口令 (S2 首启强制改密) ------------------------------------
# 未设置时回退弱默认 admin123（仅首启），新 admin 带 must_change_password=true，
# 登录后须改密。生产环境务必显式设置为强口令，或首登后立即改密。
# ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# ---- 开发旁路开关 (P2-6，生产严禁开启) -----------------------------------
# DEVELOPMENT_MODE=true 会伪造 superuser 直接放行全部请求，仅本地调试用。
# 生产（PROFILE/RUST_ENV/ENV=prod|production）强制忽略，仍要求真实 JWT 认证。
DEVELOPMENT_MODE=false

# ==============================================================================
# 服务端口配置 (统一端口规范 - 与 config/services.yaml 保持一致)
# ==============================================================================

# 平台核心服务 (8000-8009) - 统一承载于 unified-core
CORE_PORT=8000
IAM_PORT=8000
DOC_PORT=8000
FILE_PORT=8000
FLOW_PORT=8000
MAIL_PORT=8000
IM_PORT=8000
NOTIFICATION_PORT=8000

# 经营管理服务 (8010-8019)
ERP_PORT=8010
FINANCE_PORT=8011
AI_PORT=8013

# 协同办公服务 (8020-8029)
HRM_PORT=8020
PM_PORT=8023
CRM_PORT=8029

# 生产制造服务 (8030-8039)
MES_PORT=8030
PDM_PORT=8031

# 供应链服务 (8040-8049)
SCM_PORT=8040
WMS_PORT=8041
SRM_PORT=8042

# 质量/研发服务 (8050-8059)
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
RD_PORT=8053

# 数据分析/门户服务 (8060-8069)
BI_PORT=8060
PORTAL_PORT=8063

# 基础设施服务 (8070-8079)
MOBILE_PORT=8070
GIS_PORT=8071
INTEGRATION_PORT=8072

# 扩展服务 (8082-8090)
SEARCH_PORT=8082
COMMUNICATION_PORT=8084
# [P2-2 2026-10-20 标注] 已废弃：billing 服务已下线（svc/ 无此目录，Cargo.toml 注明移除），键保留仅为兼容旧配置，代码不再读取
BILLING_PORT=8085
TICKET_PORT=8086
# [P2-2 2026-10-20 标注] 已废弃：feedback 服务已并入 ticket（Cargo.toml 注明 feedback→ticket），键保留仅为兼容旧配置，代码不再读取
FEEDBACK_PORT=8087
# [V2026.08 已移除] lowcode 空壳占位服务（原端口 8088）
# LOWCODE_PORT=8088
MASTER_DATA_PORT=8090

# 服务网关 & 前端入口
GATEWAY_PORT=8080
WEB_PORT=3000

# 外部依赖端口
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# ==============================================================================
# 下游服务 URL 配置
# ==============================================================================
CORE_SERVICE_URL=http://localhost:8099
WORKFLOW_SERVICE_URL=http://localhost:8099
AI_SERVICE_URL=http://localhost:8099

# ==============================================================================
# 文件服务配置
# ==============================================================================
STORAGE_LOCAL_PATH=./storage/files
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10
MAX_FILE_SIZE=104857600

# ==============================================================================
# AI 服务配置 (Ollama 本地 AI)
# ==============================================================================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VECTOR_DIMENSION=3584
EMBEDDING_MODEL=nomic-embed-text

# 向量搜索配置
VECTOR_INDEX_PREFIX=topems
VECTOR_SEARCH_LIMIT=10
VECTOR_SIMILARITY_THRESHOLD=0.75

# ==============================================================================
# 可选: 云端 AI 配置 (OpenAI/通义等)
# ==============================================================================
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_API_KEY=
# OPENAI_MODEL=text-embedding-3-small
# OPENAI_VECTOR_DIMENSION=1536


# ==============================================================================
# Dify AI 集成 (self-hosted via docker-compose / Dify Cloud)
# ==============================================================================
# Dify base URL (local self-hosted: http://localhost:8099, cloud: https://api.dify.ai)
DIFY_BASE_URL=http://localhost:8099
# Dify app API key (generate from Dify console: App -> API Access -> API Key)
DIFY_API_KEY=
# Default user identifier for Dify API calls
DIFY_DEFAULT_USER=topems-user
# Request timeout in seconds
DIFY_TIMEOUT_SECS=120

# ==============================================================================
# 邮件服务配置
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
# 本机生产建议不落盘：存 macOS Keychain（service=topems-smtp-password），
# 由 scripts/deploy/launch-with-keychain.sh 在 launchd 启动时注入
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_ADDRESS=your-email@example.com

# ==============================================================================
# 插件注册配置
# ==============================================================================
PLUGIN_AUTO_REGISTER=true
PLUGIN_REGISTER_URL=http://localhost:8099/api/core/plugin/dev/plugins

# 插件注册安全令牌（V13.0 新增）
# 生产环境必须设置；留空或未设置时为开发模式（跳过验证）
# 生成方式：openssl rand -hex 32
# [P2-2 2026-10-20 提示] 本地 .env 当前为空、.env.production 已配置 64 位令牌；
# 建议为本地 .env 生成并配置（openssl rand -hex 32），避免插件令牌门控在本地失效
PLUGIN_REGISTRATION_TOKEN=

# ==============================================================================
# 服务发现配置 (V13.0 新增)
# ==============================================================================
# Consul 服务发现——预留扩展点（D5/U9 2026-10-03）：默认关，设 CONSUL_URL 即自动启用；
# 生产唯一生效路径为 env SERVICE_URL 静态寻址 + nginx 静态转发（config/services.yaml 权威源）。
# 注：zookeeper/eureka/nacos 已按 D5 移除（未接线残留），不再提供。
CONSUL_ENABLED=false
CONSUL_URL=http://localhost:8099
CONSUL_TOKEN=

# 服务注册心跳间隔（秒）
SERVICE_HEARTBEAT_INTERVAL=30

# 插件心跳超时阈值（秒，超过此值标记为 offline）
PLUGIN_HEARTBEAT_TIMEOUT=90

# ==============================================================================
# 性能测试配置 (k6 / benchmark.sh)
# ==============================================================================
# 性能测试套件入口：./scripts/performance/run-all-tests.sh
# 双模式：冒烟 (SMOKE=true)  / 完整 (默认)

# 后端服务地址（k6 测试目标）
PERF_BASE_URL=http://localhost:8099

# 冒烟测试开关（true 时跳过完整性能测试的高 VUs/长 Duration）
PERF_SMOKE=false

# benchmark.sh 基准测试参数
BENCH_HOST=localhost
BENCH_REQUESTS=100

# ==============================================================================
# 其他配置
# ==============================================================================
ENVIRONMENT=development
RUST_LOG=info,service_discovery=info,rd::ai_integration=info,portal::federation_gateway=debug,portal::graphql_schema=debug,portal::intelligent_gateway=debug

# ==============================================================================
# 安全加固配置（P6-3 审计补全）
# ==============================================================================
# 部署模式：development / staging / production
# 生产环境 JWT_SECRET 缺失会 panic，可在此设为 production 以触发严格检查
DEPLOYMENT_MODE=development

# 加密主密钥（AES-256），用于敏感数据加解密；生产环境必须设置（openssl rand -hex 32）
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY=

# 多租户与默认租户（未开启时单租户模式，DEFAULT_TENANT_ID 可选）
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=topems

# 高级安全开关（未显式设置时默认 false）
IP_WHITELIST_ENABLED=false
QUOTA_ENABLED=false
SSO_ENABLED=false
TWO_FACTOR_REQUIRED=false

# ==============================================================================
# Schema 防御严格模式（V69.2 新增）
# ==============================================================================
# 控制 run_schema_defense() 的 verify_table_columns 行为：
# - false / 未设置：缺列仅打 tracing::warn!，不阻塞服务启动（开发/演示/回归环境推荐）
# - true：缺列直接 panic 并返回非 0 退出码；缺失列清单写入 stderr
#   适用于 CI 硬门禁 / 生产发布前的冒烟（配合 topems.sh db defense-check 使用）
SCHEMA_DEFENSE_VERIFY_STRICT=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8099
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# SQLx 离线编译配置（V64+ 新增）
# ==============================================================================
# 推荐开启后不依赖数据库连接即可编译，方便 CI、断网、克隆后直接构建
# 缓存生成命令：
#   ./scripts/topems.sh sqlx prepare --all
#   ./scripts/dev/sqlx-prepare.sh
# 缓存校验命令：
#   ./scripts/topems.sh sqlx check-offline
#   SQLX_OFFLINE=true cargo check --workspace
# 注意：新增/修改 SQL 语句后需重新 prepare 并提交 .sqlx/ 目录下的变更
SQLX_OFFLINE=true
SQLX_OFFLINE_DIR=.sqlx

# 设为 1 时 build/build-all 不优先走离线缓存，直接在线编译（需 DATABASE_URL）
FORCE_ONLINE_BUILD=0

# ==============================================================================
# scripts/topems.sh 脚本行为调节（对应 topems.sh help 环境变量段）
# ==============================================================================
# 服务注册/健康检查失败时的最大重试次数（默认 3）
MAX_RETRIES=3

# 重试初始间隔（秒，默认 3）
RETRY_DELAY=3

# 指数退避倍数（默认 2；第 n 次等待 = RETRY_DELAY * BACKOFF_FACTOR^(n-1)）
BACKOFF_FACTOR=2

# 设为 1 时跳过 SQLx 离线缓存新鲜度门禁（等同命令加 --skip-sqlx-check；默认 0=门禁生效）
SQLX_CHECK_SKIP=0

# 清理磁盘守卫阈值（GiB）：磁盘剩余 < DISK_BLOCK_GB 时 topems clean 拒绝执行（阻断）
DISK_BLOCK_GB=5

# 清理磁盘守卫阈值（GiB）：磁盘剩余 < DISK_WARN_GB 时 topems clean 给出警告提示
DISK_WARN_GB=10

# ================================================
# 模块化单体模式配置
# ================================================
# 设置为 1 时，前端代理会把所有 API 请求转发到统一入口（topems-server:8099）
# 设置为空或 0 时，前端代理会把 API 请求转发到各个独立服务的端口
VITE_MONOLITH=1

# ================================================
# search 服务 backfill 配置（B1）
# ================================================
# search 启动时从 erp /api/erp/internal/searchable-snapshot 拉全量对账投影表
# （backfill_projections）。该内部接口受全局认证保护，必须提供有效 JWT：
# 缺失时 backfill 请求 401 → 静默空跑（源快照 0 条），对账形同虚设且无告警。
# 需为含 exp 字段的有效 JWT（erp 认证中间件要求 exp）：建议使用远期过期（如 10 年）
# 的服务令牌（sub=backfill-bootstrap，permissions=["*"]，与 JWT_SECRET 同签发）。
BACKFILL_TOKEN=

# ==============================================================================
# P2-2 补登（2026-10-20）：审计发现的漂移键登记（占位空值，按需填写）
# 来源：.env 与 .env.production 中实际使用但模板未登记之键（审计"WIP目录与env审计"）。
# 说明：仅登记键名与用途说明，值留空占位；真实密钥请勿提交，按各键注释生成。
# ==============================================================================

# ---- 来自 .env（本地实际使用，模板未登记）----
# 功能开关：是否启用 billing（已下线服务，兼容保留）
BILLING_ENABLED=
# 文件服务 URL（file 域独立部署时使用，代码读取见 svc/ai/src/main.rs 等）
FILE_SERVICE_URL=
# 已下线 lowcode 服务的端口（兼容保留）
LOWCODE_PORT=
# 监控服务端口（monitor 独立服务，V68.1 重建，main.rs 默认 8095）
MONITOR_PORT=
# 插件注册服务端口（plugin-registry，services.yaml 默认 8096）
PLUGIN_REGISTRY_PORT=
# 模块化单体端口（topems-server，main.rs / lib/shared-bootstrap 读取，config/ports.env 默认 8099）
SERVER_PORT=
# 监听地址（topems-server 等，lib/shared-bootstrap 读取；留空/不设 = 默认回环 127.0.0.1，
# 进程只接受本机连接、对外统一走 nginx。仅容器端口映射等确需全部网卡时才显式填 0.0.0.0）
BIND_ADDR=
# 物流服务端口（tms，svc/tms/src/main.rs 读取，config/ports.env 默认 8073）
TMS_PORT=
# 刷新令牌签名密钥（JWT_REFRESH_SECRET 同义词兼容，本地已使用）
REFRESH_SECRET=
# 运行时 search_path（连接池 after_connect 唯一权威来源，默认 "rs, erp, public"）
SEARCH_PATH=
# 租户管理开关（unified-core）
TENANT_MANAGEMENT=
# 租户 RLS 隔离开关
TENANT_RLS_ENABLED=
# 租户 RLS 跳过路径（逗号分隔）
TENANT_RLS_SKIP_PATHS=

# ---- 来自 .env.production（生产实际使用，模板未登记）----
# AI 默认模型
AI_DEFAULT_MODEL=
# 全局数据库连接池上限（max_connections=50 预算上限 45）
DATABASE_MAX_CONNECTIONS=
# 连接池获取超时
DATABASE_POOL_TIMEOUT=
# 默认租户隔离模式
DEFAULT_TENANT_ISOLATION=
# 功能开关：AI / GIS / 指标 / 移动端 / 插件市场 / 限流
ENABLE_AI=
ENABLE_GIS=
ENABLE_METRICS=
ENABLE_MOBILE=
ENABLE_PLUGIN_MARKETPLACE=
ENABLE_RATE_LIMIT=
# 健康检查间隔
HEALTH_CHECK_INTERVAL=
# 监听主机
HOST=
# JWT 过期小时数
JWT_EXPIRATION_HOURS=
# 日志级别
LOG_LEVEL=
# 上传大小上限（MB）
MAX_FILE_SIZE_MB=
# 最大租户数
MAX_TENANTS=
# 指标端口
METRICS_PORT=
# Ollama 端点
OLLAMA_ENDPOINT=
# 插件存储路径
PLUGIN_STORAGE_PATH=
# 限流每分钟请求数
RATE_LIMIT_REQUESTS_PER_MINUTE=
# Redis 连接池大小
REDIS_POOL_SIZE=
# 会话签名密钥（openssl rand -hex 32）
SESSION_SECRET=
# 存储路径
STORAGE_PATH=
# 存储类型
STORAGE_TYPE=
# 向量库类型
VECTOR_STORE_TYPE=

