# TOPEMS 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ================================================
# 数据库配置
# ================================================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems

# ================================================
# JWT 认证配置 - 所有服务必须使用相同的 secret
# ================================================
JWT_SECRET=topems-jwt-secret-key-must-be-at-least-32-characters-long-for-hs256
JWT_REFRESH_SECRET=topems-jwt-refresh-secret-key-must-be-at-least-32-characters-long
# 兼容旧名称
REFRESH_SECRET=topems-jwt-refresh-secret-key-must-be-at-least-32-characters-long

# Token 过期时间（小时）
JWT_EXPIRY_HOURS=24

# ================================================
# 服务端口配置
# ================================================
IAM_PORT=8000
PM_PORT=8001
NOTIFICATION_PORT=8002
PORTAL_PORT=8003
FLOW_PORT=8004
INTEGRATION_PORT=8005
ERP_PORT=8010
HRM_PORT=8011
CRM_PORT=8012
RS_PORT=8020
LIMS_PORT=8022
PDM_PORT=8023
DOC_PORT=8024
MES_PORT=8030
QMS_PORT=8031
EHS_PORT=8032
SCM_PORT=8040
SRM_PORT=8041
WMS_PORT=8042
FILE_PORT=8050
MAIL_PORT=8051
IM_PORT=8052
GIS_PORT=8053
BI_PORT=8060
REPORT_PORT=8061
AI_PORT=8062
MOBILE_PORT=8070

# ================================================
# 下游服务 URL 配置
# ================================================
FILE_SERVICE_URL=http://localhost:8050
AI_SERVICE_URL=http://localhost:8062

# ================================================
# 文件服务配置
# ================================================
STORAGE_LOCAL_PATH=./storage/files

# ================================================
# AI 服务配置 (Ollama 本地 AI)
# ================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# ================================================
# 可选: 云端 AI 配置 (OpenAI/通义等)
# ================================================
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# ================================================
# 邮件服务配置
# ================================================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=topmap@163.com
SMTP_PASSWORD=BMyf23ZqRburuhCv
SMTP_FROM_ADDRESS=topmap@163.com

# ================================================
# 日志配置
# ================================================
RUST_LOG=info

# ================================================
# 数据库搜索路径
# ================================================
