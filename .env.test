# TOPEMS 测试环境配置
# ================================
# 此文件用于 CI/CD 和自动化测试

NODE_ENV=test
RUST_ENV=test
APP_ENV=test

# ================================
# 数据库配置 - 测试环境
# ================================
DATABASE_URL=postgres://topems_test:topems_test_secret@localhost:5432/topems_test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems_test
DB_USER=topems_test
DB_PASSWORD=topems_test_secret
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_SIZE=1
DB_CONNECT_TIMEOUT=5
DB_IDLE_TIMEOUT=60

# 独立的测试数据库
TEST_DATABASE_URL=postgres://topems_test:topems_test_secret@localhost:5432/topems_test
TEST_DB_NAME=topems_test

# ================================
# 认证配置 - 测试环境
# ================================
JWT_SECRET=test-jwt-secret-key-for-testing-only-32chars
JWT_EXPIRY_HOURS=1
JWT_REFRESH_SECRET=test-refresh-secret-for-testing-only
JWT_REFRESH_EXPIRY_DAYS=1
SESSION_SECRET=test-session-secret-for-testing-only
SESSION_TIMEOUT_MINUTES=30

# ================================
# 服务配置 - 测试环境
# ================================
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8080

IAM_PORT=8002
DOC_PORT=8001
AI_PORT=8003
FLOW_PORT=8004
EHS_PORT=8005
LIMS_PORT=8006
PDM_PORT=8007
QMS_PORT=8008
RS_PORT=8009
SRM_PORT=8010
ERP_PORT=8011
NOTIFICATION_PORT=8012
REPORT_PORT=8013

CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW_SECONDS=60

# ================================
# Redis 配置 - 测试环境
# ================================
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_POOL_MAX_SIZE=3

# ================================
# 文件存储配置 - 测试环境
# ================================
UPLOAD_DIR=./test_uploads
UPLOAD_MAX_SIZE=10485760
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,pdf,txt,csv
STORAGE_PROVIDER=local

# ================================
# 邮件配置 - 测试环境（使用 MailHog）
# ================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=topems-test@localhost
SMTP_FROM_NAME=TOPEMS Test
SMTP_USE_TLS=false

# ================================
# AI 服务配置 - 测试环境（Mock）
# ================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=30
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_RESULTS=3

AI_SERVICE_URL=
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# ================================
# 日志配置 - 测试环境
# ================================
LOG_LEVEL=warn
LOG_FORMAT=json
RUST_LOG=warn
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/test.log
LOG_MAX_SIZE=10
LOG_MAX_FILES=3

# ================================
# 安全配置 - 测试环境
# ================================
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
ENCRYPTION_KEY=test-encryption-key-32-characters-min

# 测试管理员账户
ADMIN_EMAIL=test_admin@topems.com
ADMIN_PASSWORD=test_admin_password

# ================================
# 监控配置 - 测试环境
# ================================
ENABLE_TELEMETRY=false
JAEGER_ENDPOINT=
METRICS_PORT=9091

# ================================
# 功能开关 - 测试环境
# ================================
ENABLE_DEBUG_MODE=false
ENABLE_HOT_RELOAD=false
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs

# ================================
# 测试专用配置
# ================================
MOCK_EXTERNAL_SERVICES=true
USE_TEST_DATABASE=true
