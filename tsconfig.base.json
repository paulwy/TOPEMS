{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./apps/web/src/*", "./apps/desktop/src/*", "./apps/mobile/src/*"],
      "@topems/tokens": ["./packages/tokens/src"],
      "@topems/tokens/*": ["./packages/tokens/src/*"],
      "@topems/shared-types": ["./packages/shared-types/src/index.ts"],
      "@topems/shared-types/*": ["./packages/shared-types/src/*"],
      "@topems/shared-utils": ["./packages/shared-utils/src"],
      "@topems/shared-utils/*": ["./packages/shared-utils/src/*"],
      "@topems/shared-hooks": ["./packages/shared-hooks/src"],
      "@topems/shared-hooks/*": ["./packages/shared-hooks/src/*"],
      "@topems/shared-components": ["./packages/shared-components/src/index.ts"],
      "@topems/shared-components/*": ["./packages/shared-components/src/*"],
      "lucide-react": ["./apps/web/src/components/icons"],
      "react": ["./apps/mobile/node_modules/@types/react"],
      "*": ["./*"]
    }
  },
  "include": [],
  "references": [{ "path": "./packages/shared-types" }]
}
