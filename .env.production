# TOPEMS 生产环境配置
# ================================
# ⚠️ 重要安全提示：
# 1. 此文件包含敏感信息，切勿提交到版本控制
# 2. 所有密码和密钥必须从环境变量或安全密钥管理服务读取
# 3. 生产环境必须启用 HTTPS 和所有安全特性
# 4. 建议使用 Kubernetes Secrets 或 Vault 管理敏感配置

NODE_ENV=production
RUST_ENV=production
APP_ENV=production

# ================================
# 数据库配置 - 生产环境
# ================================
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_NAME=topems_prod
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_POOL_MAX_SIZE=50
DB_POOL_MIN_SIZE=10
DB_CONNECT_TIMEOUT=30
DB_IDLE_TIMEOUT=600

# ================================
# 认证配置 - 生产环境
# ================================
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY_HOURS=1
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRY_DAYS=7
SESSION_SECRET=${SESSION_SECRET}
SESSION_TIMEOUT_MINUTES=60

# OAuth 配置（可选）
OAUTH_GITHUB_CLIENT_ID=${OAUTH_GITHUB_CLIENT_ID}
OAUTH_GITHUB_CLIENT_SECRET=${OAUTH_GITHUB_CLIENT_SECRET}
OAUTH_GOOGLE_CLIENT_ID=${OAUTH_GOOGLE_CLIENT_ID}
OAUTH_GOOGLE_CLIENT_SECRET=${OAUTH_GOOGLE_CLIENT_SECRET}

# ================================
# 服务配置 - 生产环境
# ================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080

IAM_PORT=8002
DOC_PORT=8001
AI_PORT=8003
FLOW_PORT=8004
EHS_PORT=8005
LIMS_PORT=8006
PDM_PORT=8007
QMS_PORT=8008
RS_PORT=8009
SRM_PORT=8010
ERP_PORT=8011
NOTIFICATION_PORT=8012
REPORT_PORT=8013

CORS_ORIGINS=${PRODUCTION_CORS_ORIGINS}
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ================================
# Redis 配置 - 生产环境
# ================================
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_POOL_MAX_SIZE=20

# ================================
# 文件存储配置 - 生产环境
# ================================
UPLOAD_DIR=/var/topems/uploads
UPLOAD_MAX_SIZE=52428800
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip
STORAGE_PROVIDER=s3

# S3 兼容存储（生产环境推荐）
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_BUCKET_NAME=topems-prod-uploads
S3_REGION=${AWS_REGION}

# ================================
# 邮件配置 - 生产环境
# ================================
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=${SMTP_FROM}
SMTP_FROM_NAME=TOPEMS System
SMTP_USE_TLS=true

# ================================
# AI 服务配置 - 生产环境
# ================================
OLLAMA_BASE_URL=${OLLAMA_BASE_URL}
OLLAMA_MODEL=${OLLAMA_MODEL}
OLLAMA_TIMEOUT=120
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_RESULTS=5

AI_SERVICE_URL=${AI_SERVICE_URL}
AI_API_KEY=${AI_API_KEY}
AI_MODEL=${AI_MODEL}

# ================================
# 日志配置 - 生产环境
# ================================
LOG_LEVEL=info
LOG_FORMAT=json
RUST_LOG=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/topems/app.log
LOG_MAX_SIZE=100
LOG_MAX_FILES=30

# ================================
# 安全配置 - 生产环境
# ================================
ENABLE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/topems.crt
SSL_KEY_PATH=/etc/ssl/private/topems.key

ENCRYPTION_KEY=${ENCRYPTION_KEY}

# 管理员配置（通过 Kubernetes Secret 管理）
ADMIN_EMAIL=${ADMIN_EMAIL}
ADMIN_PASSWORD=${ADMIN_PASSWORD}

# ================================
# 监控和追踪 - 生产环境
# ================================
ENABLE_TELEMETRY=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
METRICS_PORT=9090

# ================================
# 功能开关 - 生产环境
# ================================
ENABLE_DEBUG_MODE=false
ENABLE_HOT_RELOAD=false
ENABLE_API_DOCS=false
API_DOCS_PATH=

# ================================
# 第三方服务集成 - 生产环境
# ================================
WECOM_WEBHOOK_URL=${WECOM_WEBHOOK_URL}
WECOM_CORP_ID=${WECOM_CORP_ID}
WECOM_CORP_SECRET=${WECOM_CORP_SECRET}

DINGTALK_WEBHOOK_URL=${DINGTALK_WEBHOOK_URL}
DINGTALK_ACCESS_TOKEN=${DINGTALK_ACCESS_TOKEN}

# ================================
# 测试配置 - 生产环境
# ================================
MOCK_EXTERNAL_SERVICES=false
USE_TEST_DATABASE=false
