# ============================================
# TOPEMS IAM 身份认证服务 - 配置模板
# ============================================
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置
# 3. 生产环境请使用环境变量注入敏感信息
#
# ============================================

# --------------------------------------------
# 服务器配置
# --------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8002

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# 数据库连接 URL（可选，未配置时使用内存模式）
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems_iam

# --------------------------------------------
# Redis 配置（可选，用于缓存和会话）
# --------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# ⚠️ 安全警告：生产环境必须设置强密钥（至少32字符）
# 使用强随机密钥，例如：openssl rand -base64 32
# JWT 密钥需要与其他服务保持一致
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters
JWT_EXPIRES_IN=86400

# --------------------------------------------
# 日志配置
# --------------------------------------------
RUST_LOG=info,topems_iam=info
RUST_BACKTRACE=1

# --------------------------------------------
# 功能特性
# --------------------------------------------
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------
# 默认管理员账号（仅在数据库模式下创建）
# --------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123
DEFAULT_ADMIN_EMAIL=admin@topems.com
