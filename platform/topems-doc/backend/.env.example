# ============================================
# TOPEMS 文档管理服务 - 配置模板
# ============================================
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置
# 3. 生产环境请使用环境变量注入敏感信息
#
# ============================================

# --------------------------------------------
# 服务器配置
# --------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# 数据库连接 URL（可选，未配置时使用内存模式）
# 文档服务支持灵活的存储模式：
#   - 内存模式（默认，无需配置）
#   - 数据库模式（配置 DATABASE_URL）
#   - 混合模式（尝试数据库连接，失败时回退到内存）
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems_doc

# --------------------------------------------
# Redis 配置（可选，用于缓存和会话）
# --------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# JWT 密钥，需要与 IAM 服务保持一致
# 生产环境请使用安全的随机密钥
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=86400

# --------------------------------------------
# 文件存储配置
# --------------------------------------------
# 存储类型：local, minio, s3
STORAGE_TYPE=local

# 本地存储路径
STORAGE_LOCAL_PATH=./storage/files

# MinIO/S3 配置（仅在 STORAGE_TYPE=minio/s3 时需要）
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=topems-docs
# MINIO_REGION=us-east-1

# --------------------------------------------
# 日志配置
# --------------------------------------------
RUST_LOG=debug,topems_doc=debug
RUST_BACKTRACE=1

# --------------------------------------------
# 功能特性
# --------------------------------------------
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传最大大小（字节，默认 500MB）
MAX_UPLOAD_SIZE=524288000

# 允许的文件类型（逗号分隔）
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,zip
