use axum::{
    extract::State,
    routing::{delete, get, patch, post, put},
    Json, Router,
};
use dotenv::dotenv;
use serde::{Deserialize, Serialize};
use sqlx::PgPool;
use std::env;
use std::net::SocketAddr;
use tracing_subscriber::{layer::SubscriberExt, util::SubscriberInitExt};
use chrono::Utc;

mod api;
mod db;
mod models;

use api::handlers::{approval, instance, workflow};
use db::WorkflowRepository;

#[tokio::main]
async fn main() {
    // 初始化日志
    tracing_subscriber::registry()
        .with(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| "topems_flow=debug,tower_http=debug".into()),
        )
        .with(tracing_subscriber::fmt::layer())
        .init();

    tracing::info!("🚀 TOPEMS-FLOW 工作流服务启动中...");

    // 加载环境变量
    dotenv().ok();

    // 初始化数据库连接池
    let database_url = env::var("DATABASE_URL")
        .unwrap_or("postgres://topems:topems_secret@localhost:5432/topems".into());
    let pool = PgPool::connect(&database_url)
        .await
        .expect("Failed to connect to the database");
    tracing::info!("✅ 数据库连接成功");

    let repo = WorkflowRepository::new(pool);

    // 构建应用
    let app = Router::new()
        .route("/", get(home))
        .route("/health", get(health))
        .route("/api/v1/workflows", post(workflow::create_workflow))
        .route("/api/v1/workflows/:id", get(workflow::get_workflow))
        .route("/api/v1/workflows", get(workflow::list_workflows))
        .route("/api/v1/workflows/:id", put(workflow::update_workflow))
        .route("/api/v1/workflows/:id", delete(workflow::delete_workflow))
        .route("/api/v1/instances", post(instance::create_instance))
        .route("/api/v1/instances/:id", get(instance::get_instance))
        .route("/api/v1/instances", get(instance::list_instances))
        .route("/api/v1/instances/:id/status", patch(instance::update_instance_status))
        .route("/api/v1/approvals", post(approval::create_approval))
        .route("/api/v1/approvals/:id", get(approval::get_approval))
        .route("/api/v1/approvals", get(approval::list_approvals))
        .route("/api/v1/approvals/:id/action", post(approval::process_approval))
        .with_state(repo);

    let port = env::var("SERVER_PORT")
        .unwrap_or("8004".to_string())
        .parse()
        .unwrap_or(8004);

    let addr = SocketAddr::from(([0, 0, 0, 0], port));

    tracing::info!("✅ TOPEMS-FLOW 服务运行在 http://{}", addr);

    axum::serve(
        tokio::net::TcpListener::bind(&addr).await.unwrap(),
        app.into_make_service(),
    )
    .await
    .unwrap();
}

#[derive(Debug, Serialize, Deserialize)]
pub struct ApiResponse<T> {
    pub code: i32,
    pub success: bool,
    pub data: Option<T>,
    pub message: String,
    pub timestamp: String,
}

impl<T> ApiResponse<T> {
    pub fn success(data: T, message: &str) -> Self {
        ApiResponse {
            code: 200,
            success: true,
            data: Some(data),
            message: message.to_string(),
            timestamp: Utc::now().to_rfc3339(),
        }
    }

    pub fn error(code: i32, message: &str) -> Self {
        ApiResponse {
            code,
            success: false,
            data: None,
            message: message.to_string(),
            timestamp: Utc::now().to_rfc3339(),
        }
    }

    pub fn ok(message: &str) -> Self {
        ApiResponse {
            code: 200,
            success: true,
            data: None,
            message: message.to_string(),
            timestamp: Utc::now().to_rfc3339(),
        }
    }
}

async fn home() -> &'static str {
    "TOPEMS-FLOW 工作流服务 API\n\n查看 API: /health\n"
}

async fn health() -> Json<ApiResponse<String>> {
    Json(ApiResponse::success("TOPEMS-FLOW is running!".to_string(), "OK"))
}
