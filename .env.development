# TOPEMS 开发环境配置
# ================================
# 此文件用于本地开发
# 从 .env.example 复制并修改

NODE_ENV=development
RUST_ENV=development
APP_ENV=development

# ================================
# 数据库配置 - 开发环境
# ================================
DATABASE_URL=postgres://topems:topems_dev@localhost:5432/topems_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems_dev
DB_USER=topems_dev
DB_PASSWORD=topems_dev
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=2
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=300

# ================================
# 认证配置 - 开发环境
# ================================
JWT_SECRET=dev-jwt-secret-key-not-for-production-use
JWT_EXPIRY_HOURS=24
JWT_REFRESH_SECRET=dev-refresh-secret-key-not-for-production
JWT_REFRESH_EXPIRY_DAYS=7
SESSION_SECRET=dev-session-secret-not-for-production
SESSION_TIMEOUT_MINUTES=240

# ================================
# 服务配置 - 开发环境
# ================================
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8080

IAM_PORT=8002
DOC_PORT=8001
AI_PORT=8003
FLOW_PORT=8004
EHS_PORT=8005
LIMS_PORT=8006
PDM_PORT=8007
QMS_PORT=8008
RS_PORT=8009
SRM_PORT=8010
ERP_PORT=8011
NOTIFICATION_PORT=8012
REPORT_PORT=8013

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# ================================
# Redis 配置 - 开发环境
# ================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_MAX_SIZE=5

# ================================
# 文件存储配置 - 开发环境
# ================================
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=104857600
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip,rar,txt,md
STORAGE_PROVIDER=local

# ================================
# 邮件配置 - 开发环境（使用 Mailhog 等本地服务）
# ================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=topems-dev@localhost
SMTP_FROM_NAME=TOPEMS Dev
SMTP_USE_TLS=false

# ================================
# AI 服务配置 - 开发环境
# ================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=60
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_RESULTS=3

AI_SERVICE_URL=
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# ================================
# 日志配置 - 开发环境
# ================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
RUST_LOG=debug,topems=debug,tower_http=debug
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/dev.log
LOG_MAX_SIZE=50
LOG_MAX_FILES=5

# ================================
# 安全配置 - 开发环境
# ================================
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
ENCRYPTION_KEY=dev-encryption-key-32-chars-min

# 开发管理员账户
ADMIN_EMAIL=admin@dev.topems.com
ADMIN_PASSWORD=dev_admin_password

# ================================
# 监控配置 - 开发环境
# ================================
ENABLE_TELEMETRY=false
JAEGER_ENDPOINT=
METRICS_PORT=9090

# ================================
# 功能开关 - 开发环境
# ================================
ENABLE_DEBUG_MODE=true
ENABLE_HOT_RELOAD=true
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs

# ================================
# 测试配置 - 开发环境
# ================================
MOCK_EXTERNAL_SERVICES=true
USE_TEST_DATABASE=true
TEST_DATABASE_URL=postgres://topems:topems_test@localhost:5432/topems_test
