# syntax=docker.1panel.live/docker/dockerfile:1
# TOPEMS 统一服务 Dockerfile 模板
# P1-1: 替换 28+ 个冗余 Dockerfile，消除 ~1300 行重复代码
#
# 使用方式:
#   docker build -f deploy/docker/Dockerfile.service \
#     --build-arg SERVICE_NAME=topems-erp \
#     --build-arg SERVICE_PORT=8010 \
#     --build-arg PORT_ENV_VAR=ERP_PORT \
#     --build-arg SERVICE_DIR=erp \
#     .
#
# 或通过构建脚本:
#   bash deploy/docker/build-service.sh erp

ARG RUST_IMAGE=docker.1panel.live/library/rust:alpine
ARG ALPINE_IMAGE=docker.1panel.live/library/alpine:3.19

# ============================================
# Stage 1: Build
# ============================================
FROM ${RUST_IMAGE} AS builder

ARG SERVICE_NAME
ARG SERVICE_DIR

WORKDIR /app

# 安装构建依赖（alpine 官方 apk 源国内慢/易卡，先换阿里云镜像源——仅换域名，原 URL 已含 /alpine/v3.x）
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories && \
    apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig protobuf

# cargo 国内镜像源 + sparse 协议 + HTTP/1.1（容器内无本机 ~/.cargo 缓存，直连 crates.io 索引国内网络易卡；
# 中科大/rsproxy sparse 均偶发 HTTP/2 流重置 PROTOCOL_ERROR（stream reset）致依赖下载挂起——故同时开启
# low-speed-limit=10 + low-speed-time=60（挂起连接 60s 无进展即失败），配合 retry=5 快速失败重试，避免卡死）
# 注意：不 COPY 项目 .cargo/config.toml（其 rustc-wrapper=sccache，容器内无 sccache 会失败）
RUN mkdir -p /root/.cargo && \
    printf '%s\n' \
      '[net]' \
      'retry = 5' \
      '' \
      '[http]' \
      'multiplexing = false' \
      'timeout = 120' \
      'low-speed-limit = 10' \
      'low-speed-time = 60' \
      '' \
      '[source.crates-io]' \
      'replace-with = "rsproxy-sparse"' \
      '' \
      '[source.rsproxy-sparse]' \
      'registry = "sparse+https://rsproxy.cn/index/"' \
      > /root/.cargo/config.toml

# 复制 workspace 文件（依赖缓存层）
COPY Cargo.toml Cargo.lock ./
COPY lib ./lib
COPY svc ./svc
COPY tools ./tools
COPY .sqlx ./.sqlx
ENV SQLX_OFFLINE=true

# 构建指定服务（仅编译该 crate，加速构建）
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release -p ${SERVICE_NAME} && \
    mkdir -p /app/out && \
    cp $(find /app/target -name ${SERVICE_NAME} -type f | head -1) /app/out/${SERVICE_NAME}

# ============================================
# Stage 2: Runtime
# ============================================
FROM ${ALPINE_IMAGE}

ARG SERVICE_NAME
ARG SERVICE_PORT
ARG PORT_ENV_VAR

# 安装运行时依赖（换阿里云 apk 镜像源——仅换域名，原 URL 已含 /alpine/v3.x）
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories && \
    apk add --no-cache libssl3 ca-certificates tzdata curl

# 创建非 root 用户
RUN addgroup -S topems && adduser -S topems -G topems

WORKDIR /app

# 从 builder 复制二进制
COPY --from=builder /app/out/${SERVICE_NAME} /usr/local/bin/${SERVICE_NAME}

# 设置所有权
RUN chown -R topems:topems /app

USER topems

# 环境默认值
ENV ${PORT_ENV_VAR}=${SERVICE_PORT}
ENV RUST_LOG=info,service_discovery=info

EXPOSE ${SERVICE_PORT}

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${SERVICE_PORT}/health || exit 1

# 运行时二进制的确定名称（shell form + exec 确保信号正确传递）
ENV SERVICE_NAME=${SERVICE_NAME}
CMD sh -c "exec ${SERVICE_NAME}"
