# TOPEMS Docker 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置
#
# ⚠️ 注意：Docker 不是 TOPEMS 的默认部署方式
# 默认使用本地进程部署（见 ../scripts/start-local.sh）
# 本文件仅在使用 docker-compose 启动容器时使用

# ==============================================================================
# PostgreSQL 配置
# ==============================================================================
POSTGRES_USER=topems
POSTGRES_PASSWORD=topems_secret
POSTGRES_DB=topems
POSTGRES_PORT=5432

# ==============================================================================
# Redis 配置
# ==============================================================================
REDIS_PORT=6379

# ==============================================================================
# JWT 配置
# ==============================================================================
# ---- JWT 密钥安全要求 ----------------------------------------------------
# 生产部署 / 真实环境必须替换！长度 ≥32 字符，不要使用任何弱默认值：
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export JWT_REFRESH_SECRET=$(openssl rand -hex 32)
# -------------------------------------------------------------------------
JWT_SECRET=<SET_YOUR_OWN_STRONG_SECRET_AT_LEAST_32_CHARS__REQUIRED>
JWT_REFRESH_SECRET=<SET_YOUR_OWN_REFRESH_SECRET_AT_LEAST_32_CHARS__MUST_BE_DIFFERENT>
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# 服务端口配置 (统一端口规范)
# ==============================================================================
# 平台核心服务 (8000-8009)
IAM_PORT=8000
DOC_PORT=8000
PM_PORT=8023
NOTIFICATION_PORT=8000
INTEGRATION_PORT=8072
PORTAL_PORT=8063
FLOW_PORT=8000

# 业务服务 (8010-8029)
ERP_PORT=8010
HRM_PORT=8020
CRM_PORT=8029
RS_PORT=8053
LIMS_PORT=8051
PDM_PORT=8031

# 制造与质量服务 (8030-8039)
MES_PORT=8030
QMS_PORT=8050
EHS_PORT=8052

# 供应链服务 (8040-8049)
SCM_PORT=8040
SRM_PORT=8042
WMS_PORT=8041

# 辅助服务 (8050-8059)
GIS_PORT=8071
IM_PORT=8000
BI_PORT=8060
REPORT_PORT=8061
MAIL_PORT=8000
MOBILE_PORT=8070

# 前端端口
FRONTEND_PORT=3000

# ==============================================================================
# 文件上传配置
# ==============================================================================
MAX_FILE_SIZE=104857600

# ==============================================================================
# 日志配置
# ==============================================================================
RUST_LOG=info

# ==============================================================================
# CORS 配置
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# 插件架构配置 (V13.0 新增)
# ==============================================================================
# 插件注册安全令牌（生产环境必须设置，生成：openssl rand -hex 32）
PLUGIN_REGISTRATION_TOKEN=

# Consul 服务发现（启用后插件通过 Consul 注册与发现）
CONSUL_ENABLED=false
CONSUL_URL=http://consul:8500
CONSUL_TOKEN=

# 插件心跳超时阈值（秒）
PLUGIN_HEARTBEAT_TIMEOUT=90

# ==============================================================================
# 安全加固配置（P6-3 审计补全）
# ==============================================================================
# 部署模式：development / staging / production
DEPLOYMENT_MODE=production

# 加密主密钥（生产环境必须设置，生成：openssl rand -hex 32）
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY=

# 多租户与默认租户
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=topems

# 高级安全开关
IP_WHITELIST_ENABLED=false
QUOTA_ENABLED=true
SSO_ENABLED=false
TWO_FACTOR_REQUIRED=false
