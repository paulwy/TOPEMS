# TOPEMS Alertmanager 环境变量配置示例
# 复制此文件为 .env 并填入实际配置值

# ============================================
# 飞书 Webhook 配置
# ============================================
# 飞书自定义机器人 Webhook URL
# 获取方式：飞书群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人 -> 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token

# ============================================
# 邮件 SMTP 配置
# ============================================
# SMTP 服务器地址（如 smtp.qq.com、smtp.163.com、smtp.gmail.com）
SMTP_HOST=smtp.example.com

# SMTP 服务器端口（通常为 465 或 587）
SMTP_PORT=465

# 发件人邮箱地址
SMTP_FROM=alertmanager@example.com

# SMTP 认证用户名（通常是邮箱地址）
SMTP_USERNAME=alertmanager@example.com

# SMTP 认证密码（邮箱授权码，不是登录密码）
SMTP_PASSWORD=your-email-authorization-code

# ============================================
# 告警通知邮箱配置
# ============================================
# AI 服务告警通知邮箱（所有 AI 服务告警）
AI_ALERT_EMAIL=ai-team@example.com

# AI 服务严重告警通知邮箱（critical 级别）
AI_CRITICAL_EMAIL=ai-oncall@example.com,ops-lead@example.com

# AI 服务警告告警通知邮箱（warning 级别）
AI_WARNING_EMAIL=ai-team@example.com

# AI 服务提示告警通知邮箱（info 级别）
AI_INFO_EMAIL=ai-team@example.com

# 通用严重告警通知邮箱
CRITICAL_EMAIL=ops-oncall@example.com,dev-lead@example.com

# 通用警告告警通知邮箱
WARNING_EMAIL=ops-team@example.com

# 通用提示告警通知邮箱
INFO_EMAIL=ops-team@example.com

# ============================================
# 告警路由配置（可选）
# ============================================
# 是否启用邮件通知（true/false）
ENABLE_EMAIL_NOTIFICATIONS=true

# 是否启用飞书通知（true/false）
ENABLE_FEISHU_NOTIFICATIONS=true

# 告警静默时间（可选，格式：cron 表达式）
# 例如：周末静默 "0 0 * * 0,6"
# ALERT_SILENCE_SCHEDULE=

# ============================================
# 配置说明
# ============================================
# 1. 飞书 Webhook URL 获取：
#    - 在飞书群中点击设置 -> 群机器人 -> 添加机器人
#    - 选择"自定义机器人"，设置名称和头像
#    - 复制生成的 Webhook 地址
#    - 可选：设置签名校验（需要在 Alertmanager 中配置）
#
# 2. 邮箱授权码获取：
#    - QQ 邮箱：设置 -> 账户 -> POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 -> 开启 SMTP -> 生成授权码
#    - 163 邮箱：设置 -> POP3/SMTP/IMAP -> 开启 SMTP -> 设置客户端授权密码
#    - Gmail：设置 -> 转发和 POP/IMAP -> 启用 IMAP -> 使用应用专用密码
#
# 3. 告警级别说明：
#    - critical（严重）：服务不可用或数据有丢失风险，需要立即处理
#    - warning（警告）：服务性能下降或存在潜在风险，需要尽快处理
#    - info（提示）：信息记录或使用量较高，关注即可
#
# 4. 告警抑制规则：
#    - critical 告警会抑制同服务的 warning 告警
#    - AI 服务宕机会抑制其他 AI 服务告警
#    - 健康检查失败会抑制其他 AI 服务告警
#    - 高错误率会抑制性能告警（错误率高时性能告警可能是次生的）
#
# 5. 测试配置：
#    配置完成后，可以使用以下命令测试告警通知：
#    ```bash
#    # 发送测试告警到 Alertmanager
#    curl -X POST http://localhost:9093/api/v1/alerts \
#      -H "Content-Type: application/json" \
#      -d '[{
#        "labels": {
#          "alertname": "TestAlert",
#          "severity": "critical",
#          "job": "topems-ai",
#          "instance": "test-instance"
#        },
#        "annotations": {
#          "summary": "这是一条测试告警",
#          "description": "用于测试告警通知渠道是否正常工作"
#        }
#      }]'
#    ```
