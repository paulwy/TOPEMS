          "values": false
        },
        "text": {},
        "textMode": "value"
      },
      "pluginVersion": "9.1.6",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100",
          "legendFormat": "错误率",
          "refId": "A"
        }
      ],
      "title": "错误率 (%)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
