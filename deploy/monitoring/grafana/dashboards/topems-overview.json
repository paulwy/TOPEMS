      "id": 5,
      "links": [],
      "options": {
        "alertThreshold": true,
        "legend": {
          "calcs": ["mean"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "red",
              "value": 0
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=~\"topems-.*\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
