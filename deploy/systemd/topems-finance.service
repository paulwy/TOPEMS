[Unit]
Description=TOPEMS 财务服务
Documentation=https://github.com/topems/topems
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=topems
Group=topems
WorkingDirectory=/opt/topems/svc/finance
ExecStart=/opt/topems/bin/finance-service
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

EnvironmentFile=/opt/topems/config/finance.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=topems-finance

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/topems/logs /opt/topems/data

LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
