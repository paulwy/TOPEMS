[Unit]
Description=TOPEMS Plugin Registry Service
Documentation=https://github.com/topems/topems
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=topems
Group=topems
WorkingDirectory=/opt/topems/svc/plugin-registry
ExecStart=/opt/topems/bin/plugin-registry-service
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

EnvironmentFile=/opt/topems/config/plugin-registry.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=topems-plugin-registry

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/topems/logs /opt/topems/data

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
