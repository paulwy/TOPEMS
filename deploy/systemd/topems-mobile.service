[Unit]
Description=TOPEMS Mobile Service
Documentation=https://github.com/topems/topems
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=topems
Group=topems
WorkingDirectory=/opt/topems/svc/mobile
ExecStart=/opt/topems/bin/mobile-service
Restart=on-failure
RestartSec=5

EnvironmentFile=/opt/topems/config/mobile.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=topems-mobile

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/topems/logs

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target