[Unit]
Description=TOPEMS PM Service
Documentation=https://github.com/topems/topems
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=topems
Group=topems
WorkingDirectory=/opt/topems/svc/pm
ExecStart=/opt/topems/bin/pm-service
Restart=on-failure
RestartSec=5

EnvironmentFile=/opt/topems/config/pm.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=topems-pm

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/topems/logs

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target