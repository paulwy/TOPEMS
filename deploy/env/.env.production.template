# ============================================
# TOPEMS 生产环境配置文件
# ============================================
# 注意：敏感配置项应使用加密方式存储
# 参考 docs/security/env-encryption.md

# ==================== 应用环境 ====================
APP_ENV=production
APP_NAME=topems
APP_HOST=0.0.0.0

# ==================== 数据库配置 ====================
DATABASE_URL=postgres://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topems_prod
DB_USER=topems_prod
DB_PASSWORD={{ENCRYPTED_DB_PASSWORD}}
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_SIZE=5
DB_CONNECT_TIMEOUT=30
DB_IDLE_TIMEOUT=300

# ==================== Redis 配置 ====================
REDIS_URL=redis://{{REDIS_PASSWORD}}@{{REDIS_HOST}}:{{REDIS_PORT}}/{{REDIS_DB}}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD={{ENCRYPTED_REDIS_PASSWORD}}
REDIS_DB=0

# ==================== JWT 配置 ====================
JWT_SECRET={{ENCRYPTED_JWT_SECRET}}
JWT_REFRESH_SECRET={{ENCRYPTED_JWT_REFRESH_SECRET}}
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# ==================== 服务器配置 ====================
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
CORS_ORIGINS=https://your-domain.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

# ==================== 安全配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECS=60

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/topems/app.log
LOG_MAX_SIZE=100
LOG_MAX_FILES=10

# ==================== 文件存储配置 ====================
UPLOAD_DIR=/var/lib/topems/uploads
UPLOAD_MAX_SIZE=104857600
STORAGE_PROVIDER=local

# ==================== 邮件配置 ====================
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASSWORD={{ENCRYPTED_SMTP_PASSWORD}}
SMTP_FROM=no-reply@your-domain.com
SMTP_FROM_NAME=TOPEMS
SMTP_USE_TLS=true

# ==================== AI 配置 ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120
USE_OLLAMA=false
OPENAI_API_KEY={{ENCRYPTED_OPENAI_API_KEY}}
OPENAI_BASE_URL=

# ==================== 缓存配置 ====================
CACHE_PREFIX=topems:
CACHE_DEFAULT_TTL=3600
MEMORY_CACHE_SIZE=10000
CACHE_EVICTION_POLICY=LRU

# ==================== 监控配置 ====================
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# ==================== 加密密钥（用于加密敏感配置） ====================
# 此密钥用于解密上面的 ENCRYPTED_* 配置项
# 生产环境应通过环境变量或密钥管理服务注入
ENCRYPTION_KEY={{ENCRYPTION_MASTER_KEY}}
