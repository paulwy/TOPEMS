# TOPEMS Production Environment Configuration
# Copy this file to /opt/topems/config/.env and customize

# ============================================================================
# Core Configuration
# ============================================================================

# Application environment
ENVIRONMENT=production

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Server host and port (per service)
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection
DATABASE_URL=postgresql://topems:your_password@localhost:5432/topems

# Database pool size
DATABASE_MAX_CONNECTIONS=20

# Database pool timeout (seconds)
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

# Redis connection
REDIS_URL=redis://localhost:6379

# Redis pool size
REDIS_POOL_SIZE=10

# ============================================================================
# Service Ports (统一端口规范 - 与 .env.example 保持一致)
# ============================================================================
# 端口区间划分:
#   8000-8009: 平台核心服务 (unified-core)
#   8010-8019: 经营管理服务
#   8020-8029: 协同办公服务
#   8030-8039: 生产制造服务
#   8040-8049: 供应链服务
#   8050-8059: 质量/研发服务
#   8060-8069: 数据/门户服务
#   8070-8079: 基础设施服务

# 平台核心服务 (unified-core: IAM, Doc, Flow, File, Communication)
CORE_PORT=8000
IAM_PORT=8000

# 经营管理服务
ERP_PORT=8010

# 协同办公服务
HRM_PORT=8020
PM_PORT=8023
CRM_PORT=8029

# 生产制造服务
MES_PORT=8030
PDM_PORT=8031

# 供应链服务
SCM_PORT=8040
WMS_PORT=8041
SRM_PORT=8042

# 质量/研发服务
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
RS_PORT=8053

# 数据/门户服务
BI_PORT=8060
REPORT_PORT=8061
MONITOR_PORT=8062
PORTAL_PORT=8063
AI_PORT=8064

# 基础设施服务
MOBILE_PORT=8070
GIS_PORT=8071
INTEGRATION_PORT=8072

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT secret key (generate a strong random key)
JWT_SECRET=your_jwt_secret_key_here_change_this

# JWT expiration (hours)
JWT_EXPIRATION_HOURS=24

# Session secret
SESSION_SECRET=your_session_secret_here

# CORS allowed origins
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================================================
# File Storage
# ============================================================================

# Storage type (local, s3)
STORAGE_TYPE=local

# Local storage path
STORAGE_PATH=/opt/topems/data/files

# Maximum file size (MB)
MAX_FILE_SIZE_MB=100

# S3 configuration (if STORAGE_TYPE=s3)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ============================================================================
# AI Configuration
# ============================================================================

# Ollama endpoint
OLLAMA_ENDPOINT=http://localhost:11434

# Default AI model
AI_DEFAULT_MODEL=llama3

# Vector store type (postgres, memory)
VECTOR_STORE_TYPE=postgres

# ============================================================================
# Email Configuration
# ============================================================================

# SMTP host
SMTP_HOST=smtp.example.com

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=your_email@example.com

# SMTP password
SMTP_PASSWORD=your_smtp_password

# From address
EMAIL_FROM=noreply@your-domain.com

# ============================================================================
# Monitoring
# ============================================================================

# Prometheus metrics port
METRICS_PORT=9090

# Enable metrics
ENABLE_METRICS=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# ============================================================================
# Tenant Configuration
# ============================================================================

# Default tenant isolation mode (independent, shared)
DEFAULT_TENANT_ISOLATION=shared

# Maximum tenants per instance
MAX_TENANTS=100

# ============================================================================
# Plugin Configuration
# ============================================================================

# Plugin storage path
PLUGIN_STORAGE_PATH=/opt/topems/data/plugins

# Enable plugin marketplace
ENABLE_PLUGIN_MARKETPLACE=true

# ============================================================================
# Rate Limiting
# ============================================================================

# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# Feature Flags
# ============================================================================

# Enable AI features
ENABLE_AI=true

# Enable GIS features
ENABLE_GIS=true

# Enable mobile features
ENABLE_MOBILE=true