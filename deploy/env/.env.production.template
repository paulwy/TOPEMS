# TOPEMS Production Environment Configuration
# Copy this file to /opt/topems/config/.env and customize

# ============================================================================
# Core Configuration
# ============================================================================

# Application environment
ENVIRONMENT=production

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Server host and port (per service)
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection
DATABASE_URL=postgresql://topems:your_password@localhost:5432/topems

# Database pool size
DATABASE_MAX_CONNECTIONS=20

# Database pool timeout (seconds)
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

# Redis connection
REDIS_URL=redis://localhost:6379

# Redis pool size
REDIS_POOL_SIZE=10

# ============================================================================
# Service Ports
# ============================================================================

# Unified Core (IAM, Doc, Flow, File, Communication, Tenant, Billing, Plugin)
UNIFIED_CORE_PORT=8001

# AI Service
AI_SERVICE_PORT=8002

# Analytics Service (BI, Report)
ANALYTICS_SERVICE_PORT=8003

# Manufacturing Service (MES, PDM)
MANUFACTURING_SERVICE_PORT=8004

# Quality Assurance (QMS, LIMS, EHS)
QUALITY_ASSURANCE_SERVICE_PORT=8005

# HRM Service
HRM_SERVICE_PORT=8006

# CRM Service
CRM_SERVICE_PORT=8007

# PM Service
PM_SERVICE_PORT=8008

# ERP Service
ERP_SERVICE_PORT=8009

# GIS Service
GIS_SERVICE_PORT=8010

# RS Service
RS_SERVICE_PORT=8011

# SCM Service
SCM_SERVICE_PORT=8012

# WMS Service
WMS_SERVICE_PORT=8013

# Mobile Service
MOBILE_SERVICE_PORT=8014

# Monitor Service
MONITOR_SERVICE_PORT=8015

# Portal (API Gateway)
PORTAL_SERVICE_PORT=8080

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT secret key (generate a strong random key)
JWT_SECRET=your_jwt_secret_key_here_change_this

# JWT expiration (hours)
JWT_EXPIRATION_HOURS=24

# Session secret
SESSION_SECRET=your_session_secret_here

# CORS allowed origins
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================================================
# File Storage
# ============================================================================

# Storage type (local, s3)
STORAGE_TYPE=local

# Local storage path
STORAGE_PATH=/opt/topems/data/files

# Maximum file size (MB)
MAX_FILE_SIZE_MB=100

# S3 configuration (if STORAGE_TYPE=s3)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ============================================================================
# AI Configuration
# ============================================================================

# Ollama endpoint
OLLAMA_ENDPOINT=http://localhost:11434

# Default AI model
AI_DEFAULT_MODEL=llama3

# Vector store type (postgres, memory)
VECTOR_STORE_TYPE=postgres

# ============================================================================
# Email Configuration
# ============================================================================

# SMTP host
SMTP_HOST=smtp.example.com

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=your_email@example.com

# SMTP password
SMTP_PASSWORD=your_smtp_password

# From address
EMAIL_FROM=noreply@your-domain.com

# ============================================================================
# Monitoring
# ============================================================================

# Prometheus metrics port
METRICS_PORT=9090

# Enable metrics
ENABLE_METRICS=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# ============================================================================
# Tenant Configuration
# ============================================================================

# Default tenant isolation mode (independent, shared)
DEFAULT_TENANT_ISOLATION=shared

# Maximum tenants per instance
MAX_TENANTS=100

# ============================================================================
# Plugin Configuration
# ============================================================================

# Plugin storage path
PLUGIN_STORAGE_PATH=/opt/topems/data/plugins

# Enable plugin marketplace
ENABLE_PLUGIN_MARKETPLACE=true

# ============================================================================
# Rate Limiting
# ============================================================================

# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# Feature Flags
# ============================================================================

# Enable AI features
ENABLE_AI=true

# Enable GIS features
ENABLE_GIS=true

# Enable mobile features
ENABLE_MOBILE=true