# ==============================================================================
# Redis 配置
# ==============================================================================
REDIS_PORT=6379

# ==============================================================================
# JWT 配置
# ==============================================================================
# ⚠️ 安全警告：生产环境必须设置强密钥（至少32字符）
# 使用强随机密钥，例如：openssl rand -base64 32
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# 服务端口配置 (统一端口规范)
# ==============================================================================
# 平台核心服务 (8000-8009)
IAM_PORT=8000
DOC_PORT=8001
PM_PORT=8002
NOTIFICATION_PORT=8003
INTEGRATION_PORT=8004
PORTAL_PORT=8005
FLOW_PORT=8006

# 业务服务 (8010-8029)
ERP_PORT=8010
HRM_PORT=8011
CRM_PORT=8012
AI_PORT=8013
RS_PORT=8020
LIMS_PORT=8022
PDM_PORT=8023

# 制造与质量服务 (8030-8039)
MES_PORT=8030
QMS_PORT=8031
EHS_PORT=8032

# 供应链服务 (8040-8049)
SCM_PORT=8040
SRM_PORT=8041
WMS_PORT=8042

# 辅助服务 (8050-8059)
GIS_PORT=8050
IM_PORT=8051
BI_PORT=8052
REPORT_PORT=8053
MAIL_PORT=8054
MOBILE_PORT=8055

# 前端端口
FRONTEND_PORT=3000

# ==============================================================================
# 文件上传配置
# ==============================================================================
MAX_FILE_SIZE=104857600

# ==============================================================================
# 日志配置
# ==============================================================================
RUST_LOG=info

# ==============================================================================
# CORS 配置
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
