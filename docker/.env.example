# TOPEMS 环境变量示例文件
# 复制此文件为 .env 并根据需要修改配置

# PostgreSQL 配置
POSTGRES_USER=topems
POSTGRES_PASSWORD=topems_secret
POSTGRES_DB=topems
POSTGRES_PORT=5432

# Redis 配置
REDIS_PORT=6379

# JWT 配置
JWT_SECRET=topems-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# 文件上传配置
MAX_FILE_SIZE=104857600

# 日志级别
RUST_LOG=info
