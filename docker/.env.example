# TOPEMS 环境变量配置
# 复制此文件为 .env 并根据实际环境修改

# ==================== 数据库配置 ====================
POSTGRES_USER=topems
POSTGRES_PASSWORD=topems_secret
POSTGRES_DB=topems
POSTGRES_PORT=5432

# ==================== Redis 配置 ====================
REDIS_PORT=6379

# ==================== JWT 配置 ====================
JWT_SECRET=your-production-jwt-secret-change-here
JWT_EXPIRATION_HOURS=24

# ==================== IAM 服务配置 ====================
IAM_SERVICE_URL=http://localhost:8000
IAM_JWT_SECRET=topems-iam-jwt-secret

# ==================== AI 服务配置 ====================
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# ==================== 邮件服务配置 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@topems.com
SMTP_PASSWORD=smtp-password

# ==================== 监控配置 ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ==================== RabbitMQ 配置 ====================
RABBITMQ_USER=topems
RABBITMQ_PASSWORD=topems_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==================== 文件存储配置 ====================
STORAGE_TYPE=local
STORAGE_PATH=./storage

# ==================== 服务端口配置 ====================
# 核心服务 (8000-8009)
# IAM: 8000
# NOTIFICATION: 8004
# PORTAL: 8005
# FLOW: 8006
# INTEGRATION: 8007

# ERP/财务服务 (8010-8019)
# ERP: 8010
# HRM: 8012
# CRM: 8013

# PLM/研发服务 (8020-8029)
# RS: 8020
# DOC: 8021
# LIMS: 8022
# PDM: 8023

# MES/生产服务 (8030-8039)
# MES: 8030
# QMS: 8031
# EHS: 8032

# SCM/供应链服务 (8040-8049)
# SCM: 8040
# SRM: 8041
# WMS: 8042

# 基础设施服务 (8050-8059)
# FILE: 8050
# MAIL: 8051
# IM: 8052
# GIS: 8053

# 数据分析服务 (8060-8069)
# BI: 8060
# REPORT: 8061
# AI: 8062

# 预留扩展服务 (8070-8079)
# MOBILE: 8070

# ==================== 日志配置 ====================
RUST_LOG=info
RUST_BACKTRACE=1

# ==================== CORS 配置 ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
