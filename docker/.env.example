# TOPEMS Docker 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置
#
# ⚠️ 注意：Docker 不是 TOPEMS 的默认部署方式
# 默认使用本地进程部署（见 ../scripts/start-local.sh）
# 本文件仅在使用 docker-compose 启动容器时使用

# ==============================================================================
# PostgreSQL 配置
# ==============================================================================
POSTGRES_USER=topems
POSTGRES_PASSWORD=topems_secret
POSTGRES_DB=topems
POSTGRES_PORT=5432

# ==============================================================================
# Redis 配置
# ==============================================================================
REDIS_PORT=6379

# ==============================================================================
# JWT 配置
# ==============================================================================
# ⚠️ 安全警告：生产环境必须设置强密钥（至少32字符）
# 使用强随机密钥，例如：openssl rand -base64 32
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# 服务端口配置 (统一端口规范)
# ==============================================================================
# 平台核心服务 (8000-8009)
IAM_PORT=8000
DOC_PORT=8000
PM_PORT=8023
NOTIFICATION_PORT=8000
INTEGRATION_PORT=8072
PORTAL_PORT=8063
FLOW_PORT=8000

# 业务服务 (8010-8029)
ERP_PORT=8010
HRM_PORT=8020
CRM_PORT=8029
RS_PORT=8053
LIMS_PORT=8051
PDM_PORT=8031

# 制造与质量服务 (8030-8039)
MES_PORT=8030
QMS_PORT=8050
EHS_PORT=8052

# 供应链服务 (8040-8049)
SCM_PORT=8040
SRM_PORT=8042
WMS_PORT=8041

# 辅助服务 (8050-8059)
GIS_PORT=8071
IM_PORT=8000
BI_PORT=8060
REPORT_PORT=8061
MAIL_PORT=8000
MOBILE_PORT=8070

# 前端端口
FRONTEND_PORT=3000

# ==============================================================================
# 文件上传配置
# ==============================================================================
MAX_FILE_SIZE=104857600

# ==============================================================================
# 日志配置
# ==============================================================================
RUST_LOG=info

# ==============================================================================
# CORS 配置
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
