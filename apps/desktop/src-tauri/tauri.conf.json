{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "TOPEMS",
  "version": "1.0.0",
  "identifier": "com.topems.desktop",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TOPEMS - Enterprise Management System",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:8080 https://api.topems.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/icon-96x96.png",
      "../icons/icon-128x128.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright 2024 TOPEMS Team",
    "category": "Business",
    "shortDescription": "Enterprise Management System",
    "longDescription": "TOPEMS is a comprehensive enterprise management system providing integrated solutions for HR, CRM, ERP, and more."
  },
  "plugins": {
    "shell": {},
    "fs": {},
    "dialog": {},
    "opener": {},
    "log": {}
  }
}
