{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "TOPEMS",
  "version": "1.0.0",
  "identifier": "com.topems.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TOPEMS - Enterprise Management System",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.googleapis.com; connect-src 'self' http://localhost:3000 http://localhost:8000 http://localhost:8080 https://api.topems.com; media-src 'self'; object-src 'none'; frame-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/icon-96x96.png",
      "../icons/icon-128x128.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright 2024 TOPEMS Team",
    "category": "Business",
    "shortDescription": "Enterprise Management System",
    "longDescription": "TOPEMS is a comprehensive enterprise management system providing integrated solutions for HR, CRM, ERP, and more.",
    "macOS": {
      "signingIdentity": "Developer ID Application: TOPEMS Team",
      "entitlements": "../entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "shell": {},
    "fs": {},
    "dialog": {},
    "opener": {},
    "log": {},
    "global-shortcut": {},
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.topems.com/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmltdW0gc2lnbmluZyBwdWJsaWMga2V5IDggZHVyYXRpb24gMTY="
    }
  }
}