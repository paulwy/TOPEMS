{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictBindCallApply": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "types": ["node", "react", "react-dom", "@react-three/fiber"]
  },
  "include": ["src", "src/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/__tests__/**",
    "src/test/**",
    "src/api/ai/generated/**",
    "src/api/erp/index.ts",
    "src/components/bff/**",
    "src/components/ai/knowledge-graph/**",
    "src/components/ai/multi-agent/**",
    "src/components/ai/rag/**",
    "src/design-system/**",
    "src/hooks/bff/**",
    "src/modules/_archive/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
