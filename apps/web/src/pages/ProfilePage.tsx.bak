import React, { useState, useEffect, useRef, useCallback } from "react";
import {
  User,
  Mail,
  Shield,
  Settings,
  ChevronLeft,
  Save,
  RefreshCw,
  CheckCircle2,
  AlertCircle,
  Bell,
  Clock,
  Star,
  Camera,
  Activity,
  MessageSquare,
  FileText,
} from "lucide-react";
import { useNavigate } from "react-router-dom";
import { useForm } from "react-hook-form";
import { authApi, type User as UserType, type AccessLog } from "../api/iam";
import { useAppStore } from "../store";

import {
  Box,
  Button,
  TextField,
  Card,
  CardContent,
  CardHeader,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  DialogContentText,
  Tabs,
  Tab,
  Avatar,
  Switch,
  FormControlLabel,
  Chip,
  IconButton,
  Typography,
  Stack,
  Grid,
  CircularProgress,
  Divider,
} from "@mui/material";

interface ActivityItem {
  id: string;
  action: string;
  resource: string;
  success: boolean;
  error_message?: string;
  created_at: string;
  ip_address?: string;
}

interface NotificationSettings {
  email_enabled: boolean;
  system_enabled: boolean;
  workflow_enabled: boolean;
  document_enabled: boolean;
  security_enabled: boolean;
}

interface ProfileFormData {
  full_name: string;
  email: string;
}

interface PasswordFormData {
  current_password: string;
  new_password: string;
  confirm_password: string;
}

const ProfilePage: React.FC = () => {
  const navigate = useNavigate();
  const initialized = useRef(false);
  const addNotification = useAppStore((state) => state.addNotification);
  const setUser = useAppStore((state) => state.setUser);
  const shortcuts = useAppStore((state) => state.shortcuts);
  const setShortcuts = useAppStore((state) => state.setShortcuts);
  const notificationSettings = useAppStore(
    (state) => state.notificationSettings,
  );
  const setNotificationSettings = useAppStore(
    (state) => state.setNotificationSettings,
  );

  const [user, setUserState] = useState<UserType | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState(0);
  const [showPasswordDialog, setShowPasswordDialog] = useState(false);
  const [avatarUrl, setAvatarUrl] = useState<string | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const [activities, setActivities] = useState<ActivityItem[]>([]);
  const [loadingActivities, setLoadingActivities] = useState(false);

  const profileForm = useForm<ProfileFormData>({
    defaultValues: {
      full_name: "",
      email: "",
    },
  });

  const passwordForm = useForm<PasswordFormData>({
    defaultValues: {
      current_password: "",
      new_password: "",
      confirm_password: "",
    },
  });

  const loadUserProfile = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await authApi.getCurrentUser();
      if (res.success && res.data) {
        setUserState(res.data);
        profileForm.reset({
          full_name: res.data.full_name || "",
          email: res.data.email,
        });
        if (setUser) {
          setUser({
            id: res.data.id,
            username: res.data.username,
            email: res.data.email,
            fullName: res.data.full_name,
            role: res.data.role,
            roles: res.data.roles,
            permissions: res.data.permissions,
            isActive: res.data.is_active,
            isSuperuser: res.data.is_superuser,
          });
        }
      } else {
        setError(res.message || "获取用户信息失败");
      }
    } catch (err: any) {
      const errorMsg =
        err.response?.data?.message || err.message || "获取用户信息失败";
      setError(errorMsg);
      addNotification({ title: "加载失败", message: errorMsg, type: "error" });
    } finally {
      setLoading(false);
    }
  }, [setUser, addNotification, profileForm]);

  const loadActivities = useCallback(async () => {
    if (!user?.id) {
      return;
    }
    setLoadingActivities(true);
    try {
      const res = await authApi.getUserAccessLogs(user.id, 10, 0);
      if (res.success && res.data) {
        setActivities(res.data);
      }
    } catch (err) {
      console.error("加载活动记录失败", err);
    } finally {
      setLoadingActivities(false);
    }
  }, [user?.id]);

  useEffect(() => {
    if (initialized.current) {
      return;
    }
    initialized.current = true;
    loadUserProfile();
    loadActivities();
  }, [loadUserProfile, loadActivities]);

  const handleAvatarUpload = useCallback(
    async (e: React.ChangeEvent<HTMLInputElement>) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (!file.type.startsWith("image/")) {
        addNotification({
          title: "错误",
          message: "请选择图片文件",
          type: "error",
        });
        return;
      }

      if (file.size > 2 * 1024 * 1024) {
        addNotification({
          title: "错误",
          message: "图片大小不能超过2MB",
          type: "error",
        });
        return;
      }

      const reader = new FileReader();
      reader.onloadend = () => {
        const result = reader.result as string;
        setAvatarUrl(result);
        authApi
          .updateAvatar({ avatar_url: result })
          .then((res) => {
            if (res.success && res.data) {
              setUserState(res.data);
              addNotification({
                title: "成功",
                message: "头像已更新",
                type: "success",
              });
            }
          })
          .catch(() => {
            addNotification({
              title: "错误",
              message: "头像更新失败",
              type: "error",
            });
          });
      };
      reader.readAsDataURL(file);
    },
    [addNotification],
  );

  const handleProfileUpdate = useCallback(
    async (data: ProfileFormData) => {
      if (!user) return;

      try {
        const res = await authApi.updateCurrentUser({
          full_name: data.full_name || undefined,
          email: data.email,
        });

        if (res.success && res.data) {
          setUserState(res.data);
          if (setUser) {
            setUser({
              id: res.data.id,
              username: res.data.username,
              email: res.data.email,
              fullName: res.data.full_name,
              role: res.data.role,
              roles: res.data.roles,
              permissions: res.data.permissions,
              isActive: res.data.is_active,
              isSuperuser: res.data.is_superuser,
            });
          }
          addNotification({
            title: "成功",
            message: "个人信息更新成功",
            type: "success",
          });
        } else {
          addNotification({
            title: "失败",
            message: res.message || "更新失败",
            type: "error",
          });
        }
      } catch (err: any) {
        const errorMsg =
          err.response?.data?.message || err.message || "更新失败";
        addNotification({ title: "失败", message: errorMsg, type: "error" });
      }
    },
    [user, setUser, addNotification],
  );

  const handlePasswordChange = useCallback(
    async (data: PasswordFormData) => {
      if (data.new_password !== data.confirm_password) {
        addNotification({
          title: "错误",
          message: "两次输入的密码不一致",
          type: "error",
        });
        passwordForm.setError("confirm_password", {
          message: "两次输入的密码不一致",
        });
        return;
      }

      if (data.new_password.length < 6) {
        addNotification({
          title: "错误",
          message: "密码长度至少为6位",
          type: "error",
        });
        passwordForm.setError("new_password", { message: "密码长度至少为6位" });
        return;
      }

      try {
        const res = await authApi.changePassword({
          current_password: data.current_password,
          new_password: data.new_password,
        });

        if (res.success) {
          addNotification({
            title: "成功",
            message: "密码修改成功，请重新登录",
            type: "success",
          });
          setShowPasswordDialog(false);
          passwordForm.reset();
          setTimeout(() => {
            authApi.logout();
            navigate("/login");
          }, 2000);
        } else {
          addNotification({
            title: "失败",
            message: res.message || "修改密码失败",
            type: "error",
          });
        }
      } catch (err: any) {
        const errorMsg =
          err.response?.data?.message || err.message || "修改密码失败";
        addNotification({ title: "失败", message: errorMsg, type: "error" });
      }
    },
    [addNotification, navigate, passwordForm],
  );

  const handleNotificationSettingChange = useCallback(
    async (key: keyof NotificationSettings) => {
      const newSettings = {
        ...notificationSettings,
        [key]: !notificationSettings[key],
      };
      setNotificationSettings(newSettings);
      try {
        await authApi.updatePreferences({ notification_settings: newSettings });
        addNotification({
          title: "成功",
          message: `${key}通知设置已更新`,
          type: "success",
        });
      } catch (err) {
        console.error("保存通知设置失败", err);
        addNotification({
          title: "错误",
          message: "保存通知设置失败",
          type: "error",
        });
      }
    },
    [notificationSettings, addNotification],
  );

  const handleShortcutToggle = useCallback(
    (shortcut: { id: string; title: string; path: string; icon: string }) => {
      let newShortcuts: {
        id: string;
        title: string;
        path: string;
        icon: string;
      }[];
      if (shortcuts.find((s) => s.id === shortcut.id)) {
        newShortcuts = shortcuts.filter((s) => s.id !== shortcut.id);
        addNotification({
          title: "提示",
          message: `${shortcut.title}已从快捷方式移除`,
          type: "info",
        });
      } else {
        newShortcuts = [...shortcuts, shortcut];
        addNotification({
          title: "提示",
          message: `${shortcut.title}已添加到快捷方式`,
          type: "success",
        });
      }
      setShortcuts(newShortcuts);

      authApi.updatePreferences({ shortcuts: newShortcuts }).catch((err) => {
        console.error("保存快捷方式失败", err);
      });
    },
    [shortcuts, setShortcuts, addNotification],
  );

  if (loading) {
    return (
      <Box sx={{ minHeight: "100vh", bgcolor: "grey.50", display: "flex", alignItems: "center", justifyContent: "center" }}>
        <CircularProgress />
      </Box>
    );
  }

  if (error || !user) {
    return (
      <Box sx={{ minHeight: "100vh", bgcolor: "grey.50", display: "flex", alignItems: "center", justifyContent: "center" }}>
        <Box sx={{ textAlign: "center" }}>
          <AlertCircle size={48} color="error" />
          <Typography color="error" sx={{ mt: 1.5 }}>
            {error || "无法获取用户信息"}
          </Typography>
          <Button sx={{ mt: 2 }} onClick={loadUserProfile}>
            重试
          </Button>
        </Box>
      </Box>
    );
  }

  return (
    <Box sx={{ minHeight: "100vh", bgcolor: "grey.50" }}>
      <Box sx={{ bgcolor: "background.paper", borderBottom: 1, borderColor: "divider", boxShadow: 1 }}>
        <Box sx={{ maxWidth: 1152, mx: "auto", px: 3, py: 3 }}>
          <Stack direction="row" alignItems="center" justifyContent="space-between">
            <Stack direction="row" alignItems="center" spacing={2}>
              <IconButton onClick={() => navigate("/dashboard")}>
                <ChevronLeft size={20} />
              </IconButton>
              <Box>
                <Stack direction="row" alignItems="center" spacing={1.5}>
                  <User size={28} color="#2563eb" />
                  <Typography variant="h5" fontWeight="bold">
                    个人中心
                  </Typography>
                </Stack>
                <Typography variant="body2" color="text.secondary" sx={{ mt: 0.5 }}>
                  管理您的个人信息和账户安全
                </Typography>
              </Box>
            </Stack>
          </Stack>
        </Box>
      </Box>
      <Box sx={{ maxWidth: 1152, mx: "auto", px: 3, py: 3 }}>
        <Grid container spacing={3}>
          <Grid size={4}>
            <Card sx={{ position: "sticky", top: 32 }}>
              <CardContent>
                <Stack alignItems="center" textAlign="center">
                  <Box sx={{ position: "relative" }}>
                    <Avatar
                      sx={{ width: 96, height: 96, mb: 2, fontSize: 32, bgcolor: "primary.main" }}
                      src={avatarUrl || undefined}
                    >
                      {user.full_name?.charAt(0).toUpperCase() ||
                        user.username.charAt(0).toUpperCase()}
                    </Avatar>
                    <IconButton
                      onClick={() => fileInputRef.current?.click()}
                      sx={{
                        position: "absolute",
                        bottom: 16,
                        right: 0,
                        width: 32,
                        height: 32,
                        bgcolor: "primary.main",
                        color: "white",
                        boxShadow: 3,
                        "&:hover": { bgcolor: "primary.dark" },
                      }}
                      size="small"
                    >
                      <Camera size={16} />
                    </IconButton>
                    <input
                      ref={fileInputRef}
                      type="file"
                      accept="image/*"
                      onChange={handleAvatarUpload}
                      style={{ display: "none" }}
                    />
                  </Box>
                  <Typography variant="h6" sx={{ fontWeight: "medium" }}>
                    {user.full_name || user.username}
                  </Typography>
                  <Typography variant="body2" color="text.secondary" sx={{ mt: 0.5 }}>
                    {user.email}
                  </Typography>
                  <Stack spacing={1} sx={{ mt: 2, width: "100%" }}>
                    <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <User size={16} />
                      <Typography variant="body2" color="text.secondary">
                        用户名: {user.username}
                      </Typography>
                    </Stack>
                    <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <Shield size={16} />
                      <Typography variant="body2" color="text.secondary">
                        角色: {user.role || "普通用户"}
                      </Typography>
                    </Stack>
                    <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <RefreshCw size={16} />
                      <Typography variant="body2" color="text.secondary">
                        创建于: {new Date(user.created_at).toLocaleDateString("zh-CN")}
                      </Typography>
                    </Stack>
                  </Stack>
                </Stack>
              </CardContent>
            </Card>
          </Grid>

          <Grid size={8}>
            <Card>
              <CardHeader
                sx={{ pb: 0 }}
                title={
                  <Tabs value={activeTab} onChange={(_, v) => setActiveTab(v)}>
                    <Tab icon={<User size={16} />} iconPosition="start" label="个人信息" />
                    <Tab icon={<Shield size={16} />} iconPosition="start" label="账户安全" />
                    <Tab icon={<Activity size={16} />} iconPosition="start" label="最近活动" />
                    <Tab icon={<Bell size={16} />} iconPosition="start" label="通知设置" />
                    <Tab icon={<Star size={16} />} iconPosition="start" label="快捷方式" />
                  </Tabs>
                }
              />
              <CardContent>
                {/* 个人信息 Tab */}
                {activeTab === 0 && (
                  <Box
                    component="form"
                    onSubmit={profileForm.handleSubmit(handleProfileUpdate)}
                    sx={{ "& > :not(style)": { mb: 3 } }}
                  >
                    <TextField
                      fullWidth
                      size="small"
                      label="姓名"
                      {...profileForm.register("full_name")}
                      placeholder="请输入姓名"
                    />
                    <Box>
                      <TextField
                        fullWidth
                        size="small"
                        label="邮箱 *"
                        type="email"
                        {...profileForm.register("email", {
                          required: "邮箱是必填项",
                          pattern: {
                            value: /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i,
                            message: "请输入有效的邮箱地址",
                          },
                        })}
                        placeholder="请输入邮箱"
                        error={!!profileForm.formState.errors.email}
                        helperText={profileForm.formState.errors.email?.message}
                      />
                    </Box>
                    <TextField
                      fullWidth
                      size="small"
                      label="用户名"
                      value={user.username}
                      disabled
                      slotProps={{
                        input: {
                          sx: { bgcolor: "grey.100", cursor: "not-allowed" }
                        }
                      }}
                    />
                    <Stack sx={{ display: "flex", flexDirection: "row", pt: 2 }} spacing={1.5}>
                      <Button type="submit" variant="contained" startIcon={<Save size={16} />}>
                        保存更改
                      </Button>
                      <Button type="button" variant="outlined" onClick={() => profileForm.reset()}>
                        重置
                      </Button>
                    </Stack>
                  </Box>
                )}

                {/* 账户安全 Tab */}
                {activeTab === 1 && (
                  <Stack spacing={2}>
                    <Stack
                      sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "space-between", p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                    >
                      <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center" }} spacing={1.5}>
                        <Shield size={20} color="#2563eb" />
                        <Box>
                          <Typography sx={{ fontWeight: "medium" }}>修改密码</Typography>
                          <Typography variant="body2" color="text.secondary">
                            定期更新密码以保护账户安全
                          </Typography>
                        </Box>
                      </Stack>
                      <Button onClick={() => setShowPasswordDialog(true)}>
                        修改密码
                      </Button>
                    </Stack>

                    <Stack
                      direction="row"
                      alignItems="center"
                      justifyContent="space-between"
                      sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                    >
                      <Stack direction="row" alignItems="center" spacing={1.5}>
                        <Mail size={20} color="#16a34a" />
                        <Box>
                          <Typography fontWeight="medium">邮箱验证</Typography>
                          <Typography variant="body2" color="text.secondary">
                            {user.email} 已验证
                          </Typography>
                        </Box>
                      </Stack>
                      <CheckCircle2 size={20} color="#16a34a" />
                    </Stack>

                    <Stack
                      sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "space-between", p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                    >
                      <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center" }} spacing={1.5}>
                        <Settings size={20} color="#9333ea" />
                        <Box>
                          <Typography sx={{ fontWeight: "medium" }}>登录状态</Typography>
                          <Typography variant="body2" color="text.secondary">
                            当前会话活跃中
                          </Typography>
                        </Box>
                      </Stack>
                      <Button variant="outlined" onClick={authApi.logout}>
                        退出登录
                      </Button>
                    </Stack>
                  </Stack>
                )}

                {/* 最近活动 Tab */}
                {activeTab === 2 && (
                  <Box>
                    <Stack direction="row" alignItems="center" justifyContent="space-between" sx={{ mb: 2 }}>
                      <Typography fontWeight="medium">最近活动记录</Typography>
                      <Button size="small" startIcon={<RefreshCw size={16} />} onClick={loadActivities}>
                        刷新
                      </Button>
                    </Stack>
                    {loadingActivities ? (
                      <Box sx={{ textAlign: "center", py: 4 }}>
                        <CircularProgress size={32} />
                        <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
                          加载中...
                        </Typography>
                      </Box>
                    ) : activities.length === 0 ? (
                      <Box sx={{ textAlign: "center", py: 4 }}>
                        <Clock size={48} color="#9ca3af" />
                        <Typography color="text.secondary" sx={{ mt: 1.5 }}>
                          暂无活动记录
                        </Typography>
                      </Box>
                    ) : (
                      <Stack spacing={1.5}>
                        {activities.map((activity) => (
                          <Stack
                            key={activity.id}
                            sx={{ display: "flex", flexDirection: "row", p: 1.5, bgcolor: "grey.50", borderRadius: 1 }}
                            spacing={1.5}
                          >
                            <Box
                              sx={{
                                width: 8,
                                height: 8,
                                borderRadius: "50%",
                                bgcolor: activity.success ? "success.main" : "error.main",
                                mt: 1,
                              }}
                            />
                            <Box sx={{ flex: 1 }}>
                              <Stack sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "space-between" }}>
                                <Typography variant="body2" sx={{ fontWeight: "medium" }}>
                                  {activity.action}
                                </Typography>
                                <Typography variant="caption" color="text.secondary">
                                  {new Date(activity.created_at).toLocaleString("zh-CN")}
                                </Typography>
                              </Stack>
                              <Typography variant="body2" color="text.secondary">
                                {activity.resource}
                                {activity.ip_address && ` · ${activity.ip_address}`}
                              </Typography>
                              {activity.error_message && (
                                <Typography variant="caption" color="error">
                                  {activity.error_message}
                                </Typography>
                              )}
                            </Box>
                          </Stack>
                        ))}
                      </Stack>
                    )}
                  </Box>
                )}

                {/* 通知设置 Tab */}
                {activeTab === 3 && (
                  <Box>
                    <Typography fontWeight="medium" sx={{ mb: 2 }}>
                      通知偏好设置
                    </Typography>
                    <Stack spacing={2}>
                      <Stack
                        direction="row"
                        alignItems="center"
                        justifyContent="space-between"
                        sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                      >
                        <Stack direction="row" alignItems="center" spacing={1.5}>
                          <Mail size={20} color="#2563eb" />
                          <Box>
                            <Typography fontWeight="medium">邮件通知</Typography>
                            <Typography variant="body2" color="text.secondary">
                              接收重要信息的邮件通知
                            </Typography>
                          </Box>
                        </Stack>
                        <Switch
                          checked={notificationSettings.email_enabled}
                          onChange={() => handleNotificationSettingChange("email_enabled")}
                        />
                      </Stack>

                      <Stack
                        direction="row"
                        alignItems="center"
                        justifyContent="space-between"
                        sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                      >
                        <Stack direction="row" alignItems="center" spacing={1.5}>
                          <Bell size={20} color="#ca8a04" />
                          <Box>
                            <Typography fontWeight="medium">系统通知</Typography>
                            <Typography variant="body2" color="text.secondary">
                              接收系统消息和公告
                            </Typography>
                          </Box>
                        </Stack>
                        <Switch
                          checked={notificationSettings.system_enabled}
                          onChange={() => handleNotificationSettingChange("system_enabled")}
                        />
                      </Stack>

                      <Stack
                        direction="row"
                        alignItems="center"
                        justifyContent="space-between"
                        sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                      >
                        <Stack direction="row" alignItems="center" spacing={1.5}>
                          <Activity size={20} color="#16a34a" />
                          <Box>
                            <Typography fontWeight="medium">工作流通知</Typography>
                            <Typography variant="body2" color="text.secondary">
                              接收工作流审批和任务提醒
                            </Typography>
                          </Box>
                        </Stack>
                        <Switch
                          checked={notificationSettings.workflow_enabled}
                          onChange={() => handleNotificationSettingChange("workflow_enabled")}
                        />
                      </Stack>

                      <Stack
                        direction="row"
                        alignItems="center"
                        justifyContent="space-between"
                        sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                      >
                        <Stack direction="row" alignItems="center" spacing={1.5}>
                          <FileText size={20} color="#9333ea" />
                          <Box>
                            <Typography fontWeight="medium">文档通知</Typography>
                            <Typography variant="body2" color="text.secondary">
                              接收文档更新和评论提醒
                            </Typography>
                          </Box>
                        </Stack>
                        <Switch
                          checked={notificationSettings.document_enabled}
                          onChange={() => handleNotificationSettingChange("document_enabled")}
                        />
                      </Stack>

                      <Stack
                        direction="row"
                        alignItems="center"
                        justifyContent="space-between"
                        sx={{ p: 2, bgcolor: "grey.50", borderRadius: 1 }}
                      >
                        <Stack direction="row" alignItems="center" spacing={1.5}>
                          <Shield size={20} color="#dc2626" />
                          <Box>
                            <Typography fontWeight="medium">安全通知</Typography>
                            <Typography variant="body2" color="text.secondary">
                              接收登录和账户安全提醒
                            </Typography>
                          </Box>
                        </Stack>
                        <Switch
                          checked={notificationSettings.security_enabled}
                          onChange={() => handleNotificationSettingChange("security_enabled")}
                        />
                      </Stack>
                    </Stack>
                  </Box>
                )}

                {/* 快捷方式 Tab */}
                {activeTab === 4 && (
                  <Box>
                    <Typography fontWeight="medium" sx={{ mb: 2 }}>
                      我的快捷方式
                    </Typography>
                    <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                      选择您常用的功能添加到快捷方式
                    </Typography>
                    <Grid container spacing={2}>
                      {[
                        { id: "1", title: "仪表盘", icon: Activity, path: "/dashboard", color: "bg-blue-500" },
                        { id: "2", title: "文档中心", icon: FileText, path: "/documents", color: "bg-green-500" },
                        { id: "3", title: "工作流", icon: Activity, path: "/workflows", color: "bg-purple-500" },
                        { id: "4", title: "通知中心", icon: Bell, path: "/notifications", color: "bg-yellow-500" },
                        { id: "5", title: "AI助手", icon: Activity, path: "/ai", color: "bg-pink-500" },
                        { id: "6", title: "消息中心", icon: MessageSquare, path: "/im", color: "bg-indigo-500" },
                      ].map((item) => {
                        const isSelected = shortcuts.some((s) => s.id === item.id);
                        const Icon = item.icon;
                        return (
                          <Grid key={item.id} size={4}>
                            <Card
                              sx={{
                                p: 2,
                                cursor: "pointer",
                                border: 2,
                                borderColor: isSelected ? "primary.main" : "transparent",
                                bgcolor: isSelected ? "action.selected" : "grey.50",
                                "&:hover": { borderColor: "primary.light" },
                              }}
                              onClick={() =>
                                handleShortcutToggle({
                                  id: item.id,
                                  title: item.title,
                                  icon: String(item.icon),
                                  path: item.path,
                                })
                              }
                            >
                              <Stack alignItems="center" textAlign="center">
                                <Box
                                  sx={{
                                    width: 48,
                                    height: 48,
                                    borderRadius: 1,
                                    bgcolor: item.color.replace("bg-", "").replace("-500", ".main"),
                                    display: "flex",
                                    alignItems: "center",
                                    justifyContent: "center",
                                    mb: 1.5,
                                  }}
                                >
                                  <Icon size={24} color="white" />
                                </Box>
                                <Typography variant="body2" fontWeight="medium">
                                  {item.title}
                                </Typography>
                                {isSelected && (
                                  <Chip label="已添加" size="small" sx={{ mt: 1 }} />
                                )}
                              </Stack>
                            </Card>
                          </Grid>
                        );
                      })}
                    </Grid>

                    {shortcuts.length > 0 && (
                      <Box sx={{ mt: 3 }}>
                        <Typography fontWeight="medium" sx={{ mb: 2 }}>
                          当前快捷方式
                        </Typography>
                        <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
                          {shortcuts.map((shortcut) => (
                            <Chip
                              key={shortcut.id}
                              label={`${shortcut.title} ×`}
                              onClick={() => handleShortcutToggle(shortcut)}
                              sx={{ cursor: "pointer" }}
                            />
                          ))}
                        </Stack>
                      </Box>
                    )}
                  </Box>
                )}
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </Box>

      {/* 修改密码对话框 */}
      <Dialog open={showPasswordDialog} onClose={() => setShowPasswordDialog(false)} maxWidth="sm" fullWidth>
        <DialogTitle>修改密码</DialogTitle>
        <DialogContent>
          <DialogContentText>
            请输入当前密码和新密码来完成密码修改
          </DialogContentText>
          <Box
            component="form"
            onSubmit={passwordForm.handleSubmit(handlePasswordChange)}
            sx={{ "& > :not(style)": { mt: 2 } }}
          >
            <TextField
              fullWidth
              size="small"
              label="当前密码 *"
              type="password"
              {...passwordForm.register("current_password", {
                required: "当前密码是必填项",
              })}
              placeholder="请输入当前密码"
              error={!!passwordForm.formState.errors.current_password}
              helperText={passwordForm.formState.errors.current_password?.message}
            />
            <TextField
              fullWidth
              size="small"
              label="新密码 *"
              type="password"
              {...passwordForm.register("new_password", {
                required: "新密码是必填项",
                minLength: { value: 6, message: "密码长度至少为6位" },
              })}
              placeholder="请输入新密码（至少6位）"
              error={!!passwordForm.formState.errors.new_password}
              helperText={passwordForm.formState.errors.new_password?.message}
            />
            <TextField
              fullWidth
              size="small"
              label="确认新密码 *"
              type="password"
              {...passwordForm.register("confirm_password", {
                required: "请再次输入新密码",
              })}
              placeholder="请再次输入新密码"
              error={!!passwordForm.formState.errors.confirm_password}
              helperText={passwordForm.formState.errors.confirm_password?.message}
            />
          </Box>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setShowPasswordDialog(false);
              passwordForm.reset();
            }}
          >
            取消
          </Button>
          <Button variant="contained" onClick={passwordForm.handleSubmit(handlePasswordChange)} startIcon={<Save size={16} />}>
            确认修改
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default ProfilePage;
