let productStore = [...mockProducts];

const supplierProductApiAdapter: CrudApiAdapter = {
  list: async (params) => {
    const search = params?.search?.toLowerCase() || '';
    const page = params?.page || 0;
    const pageSize = params?.pageSize || 10;

    let filtered = productStore;
    if (search) {
      filtered = productStore.filter(
        (p) =>
          p.name.toLowerCase().includes(search) ||
          p.product_code.toLowerCase().includes(search) ||
          p.supplier.toLowerCase().includes(search)
      );
    }

    const total = filtered.length;
    const data = filtered.slice(page * pageSize, (page + 1) * pageSize);
    return { data: data as unknown as Record<string, unknown>[], total };
  },
  create: async (data) => {
    const newProduct: SupplierProduct = {
      id: Date.now().toString(),
      product_code: (data.product_code as string) || '',
      name: (data.name as string) || '',
      supplier: (data.supplier as string) || '',
      category: (data.category as string) || '',
      price: (data.price as number) || 0,
      unit: (data.unit as string) || i18n.t('pages.srmsupplierproductpage.key_930882'),
      status: (data.status as string) || 'active',
      created_at: new Date().toISOString().split('T')[0],
      updated_at: new Date().toISOString().split('T')[0],
    };
    productStore = [newProduct, ...productStore];
    return newProduct as unknown as Record<string, unknown>;
  },
  update: async (id, data) => {
    const idx = productStore.findIndex((p) => p.id === id);
    if (idx === -1) throw new Error(i18n.t('pages.srmsupplierproductpage.key_9001c4'));
    const updated = {
      ...productStore[idx],
      ...data,
      updated_at: new Date().toISOString().split('T')[0],
    };
    productStore[idx] = updated;
    return updated as unknown as Record<string, unknown>;
  },
  delete: async (id) => {
    productStore = productStore.filter((p) => p.id !== id);
  },
};

const SupplierProductStats: React.FC<{ rows: SupplierProduct[] }> = ({ rows }) => {
  const stats = React.useMemo(
    () => ({
      total: rows.length,
      active: rows.filter((r) => r.status === 'active').length,
      pending: rows.filter((r) => r.status === 'pending').length,
      totalValue: rows.reduce((sum, r) => sum + (r.price || 0), 0),
    }),
    [rows]
  );

  const statCards = [
    { label: i18n.t('pages.srmsupplierproductpage.key_636aa0'), value: stats.total, color: ct.purple[500], bgColor: 'secondary.light' },
    { label: i18n.t('pages.srmsupplierproductpage.key_d31f8f'), value: stats.active, color: 'success.dark', bgColor: 'success.lighter' },
    { label: i18n.t('pages.srmsupplierproductpage.key_5cb424'), value: stats.pending, color: 'warning.dark', bgColor: 'warning.lighter' },
    {
      label: i18n.t('pages.srmsupplierproductpage.key_14c0d8'),
      value: `¥${stats.totalValue.toLocaleString()}`,
      color: 'primary.dark',
      bgColor: 'primary.lighter',
    },
  ];

  return (
    <Box
      sx={{
        display: 'grid',
        gridTemplateColumns: { xs: 'repeat(1, 1fr)', md: 'repeat(4, 1fr)' },
        gap: 2,
        mb: 4,
      }}
    >
      {statCards.map((card) => (
        <Card key={card.label}>
          <CardContent sx={{ p: 2 }}>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>
              <Box
                sx={{
                  width: 40,
                  height: 40,
                  bgcolor: card.bgColor,
                  borderRadius: 3,
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                }}
              >
                <Package sx={{ width: 20, height: 20, color: card.color }} />
              </Box>
              <Box>
                <Typography
                  variant='body2'
                  sx={{ color: 'text.secondary', fontSize: '0.875rem' }}
                >
                  {card.label}
                </Typography>
                <Typography
                  variant='h5'
                  sx={{ fontWeight: 700, color: 'slate.900' }}
                >
                  {card.value}
                </Typography>
              </Box>
            </Box>
          </CardContent>
        </Card>
      ))}
    </Box>
  );
};

const SrmSupplierProductPage: React.FC = () => {
  return (
    <CrudPage
      schema={supplierProductSchema}
      apiAdapter={supplierProductApiAdapter}
      breadcrumbs={[{ label: 'SRM' }, { label: i18n.t('pages.srmsupplierproductpage.key_aed336') }]}
      headerContent={(rows) => <SupplierProductStats rows={rows as SupplierProduct[]} />}
    />
  );
};

export default SrmSupplierProductPage;
