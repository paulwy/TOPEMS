# TOPEMS 前端环境变量配置示例
# 复制此文件为 .env.local 并修改对应值

# ============================================
# UI 版本控制
# ============================================

# 是否启用 Industrial OS V3 新布局（GlobalLayoutV3 / MobileLayoutV3）
# true: 使用新布局（灰度发布/测试）
# false 或不设置: 使用旧布局（SmartLayout / GlobalLayout）
#
# 启用后影响范围：
# - 所有通过 ProtectedRouteWrapper 渲染的页面（dashboardRoutes / commonRoutes）
# - /core/* 路由（DynamicRouter）
# - 桌面端使用 GlobalLayoutV3，移动端使用 MobileLayoutV3
#
# 注意：启用前请确保已迁移的页面在新布局下正常显示
VITE_UI_V3_ENABLED=false

# ============================================
# API 配置
# ============================================

# API 基础地址
# web 端走 vite dev proxy（相对路径，同源），默认即 /api，无需显式设置。
# 仅当直连后端（绕过 proxy）时才设为绝对地址，例如独立进程 unified-core：
# VITE_API_BASE_URL=http://localhost:8000/api
# 模块化单体（topems-server:8099）：
# VITE_API_BASE_URL=http://localhost:8099/api
# 另：按服务覆盖见 VITE_<SERVICE>_SERVICE_URL（如 VITE_PLUGIN_REGISTRY_SERVICE_URL）。
# 三端 env 键统一约定见 docs/developer/frontend/api-base-url-convention.md
# VITE_API_BASE_URL=/api

# BFF GraphQL 端点（直连时）
# VITE_GRAPHQL_ENDPOINT=http://localhost:8000/graphql

# ============================================
# 其他配置
# ============================================

# 是否启用开发工具
# VITE_DEV_TOOLS_ENABLED=true
