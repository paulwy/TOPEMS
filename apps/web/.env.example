# TOPEMS Portal Environment Variables
# Copy this file to .env.local for local development

# =============================================================================
# Deployment Mode
# =============================================================================
# Options: 'module-federation' | 'static' | 'hybrid'
# - module-federation: Dynamic loading of remote modules (SaaS)
# - static: Static bundle all modules (Local installation)
# - hybrid: Core modules static + plugins dynamic
VITE_DEPLOYMENT_MODE=module-federation

# =============================================================================
# Module Federation Remote Entry URLs
# =============================================================================
# Core module remote entry (for dynamic loading mode)
VITE_CORE_REMOTE_ENTRY=http://localhost:3001/assets/remoteEntry.js

# =============================================================================
# API Base URLs
# =============================================================================
# Backend unified-core service
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable specific features
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=true
