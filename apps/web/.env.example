# TOPEMS 前端环境变量配置示例
# 复制此文件为 .env.local 并修改对应值

# ============================================
# UI 版本控制
# ============================================

# 是否启用 Industrial OS V3 新布局（GlobalLayoutV3 / MobileLayoutV3）
# true: 使用新布局（灰度发布/测试）
# false 或不设置: 使用旧布局（SmartLayout / GlobalLayout）
#
# 启用后影响范围：
# - 所有通过 ProtectedRouteWrapper 渲染的页面（dashboardRoutes / commonRoutes）
# - /core/* 路由（DynamicRouter）
# - 桌面端使用 GlobalLayoutV3，移动端使用 MobileLayoutV3
#
# 注意：启用前请确保已迁移的页面在新布局下正常显示
VITE_UI_V3_ENABLED=false

# ============================================
# API 配置
# ============================================

# API 基础地址
# VITE_API_BASE_URL=http://localhost:8080/api

# BFF GraphQL 端点
# VITE_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# ============================================
# 其他配置
# ============================================

# 是否启用开发工具
# VITE_DEV_TOOLS_ENABLED=true
