{
  "name": "topems-portal",
  "version": "5.15.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.less",
    "src/index.css",
    "src/main.tsx",
    "src/sw.ts",
    "src/i18n/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:smoke": "vitest run --project component src/__tests__/smoke-batch.test.tsx",
    "test:shard": "vitest run --project component --shard=${SHARD:-1/8}",
    "test:shard:1": "vitest run --project component --shard=1/8",
    "test:shard:2": "vitest run --project component --shard=2/8",
    "test:shard:3": "vitest run --project component --shard=3/8",
    "test:shard:4": "vitest run --project component --shard=4/8",
    "test:shard:5": "vitest run --project component --shard=5/8",
    "test:shard:6": "vitest run --project component --shard=6/8",
    "test:shard:7": "vitest run --project component --shard=7/8",
    "test:shard:8": "vitest run --project component --shard=8/8",
    "test:all": "pnpm test:unit; for i in 1 2 3 4 5 6 7 8; do pnpm test:shard:$i; done",
    "e2e": "playwright test",
    "e2e:api": "playwright test -c playwright.config.api.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:all": "npm run e2e:api && npm run e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:error": "eslint . --quiet",
    "lint:src": "eslint src/",
    "lint:src:fix": "eslint src/ --fix",
    "lint:a11y": "eslint -c eslint.a11y.config.js src/",
    "check:a11y": "node scripts/ci/check-a11y.cjs",
    "verify:nav": "node ../../scripts/verify_navigation.mjs --strict",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "topems": "bash $(cd ../../ && pwd)/scripts/topems.sh",
    "postinstall": "node scripts/postinstall.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "perf": "lighthouse --view http://localhost:8063/ --output=html --output-path=./reports/lighthouse-report.html",
    "perf:ci": "lhci autorun",
    "perf:mobile": "lighthouse http://localhost:3000/ --preset=desktop --output=html --output-path=./reports/lighthouse-mobile.html --view",
    "perf:analyze": "webpack-bundle-analyzer ./dist/stats.json",
    "gen:api": "node ../../scripts/openapi/gen-types.mjs",
    "openapi:gen": "bash ../../scripts/openapi/generate.sh --with-types"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.9.1",
    "@module-federation/runtime": "^2.8.0",
    "@module-federation/vite": "^1.16.8",
    "@mui/icons-material": "^9.2.0",
    "@mui/lab": "9.0.0-beta.5",
    "@mui/material": "^9.1.1",
    "@mui/x-date-pickers": "^7.18.0",
    "@mui/x-tree-view": "^9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^1.27.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/instrumentation": "^0.53.0",
    "@opentelemetry/instrumentation-fetch": "^0.53.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.53.0",
    "@opentelemetry/propagator-b3": "^1.27.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-trace-web": "^1.27.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@react-leaflet/core": "2.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@topems/shared-components": "workspace:*",
    "@topems/shared-constants": "workspace:*",
    "@topems/shared-hooks": "workspace:*",
    "@topems/shared-types": "workspace:*",
    "@topems/shared-utils": "workspace:*",
    "@topems/tokens": "workspace:*",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.2",
