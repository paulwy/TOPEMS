    "lighthouse": "^12.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.6",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
