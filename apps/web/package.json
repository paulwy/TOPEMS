    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
