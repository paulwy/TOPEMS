    "camelcase": "^9.0.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "decamelize": "^6.0.1",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.11",
    "eventemitter3": "^5.0.4",
    "i18next": "^26.3.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet-measure": "^3.1.0",
    "lucide-react": "^1.18.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-is": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "^11.1.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "stylis": "^4.4.0",
    "three": "^0.184.0",
    "workbox-precaching": "^7.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "^3.3.5",
