{
  "name": "topems-portal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:error": "eslint . --quiet",
    "lint:src": "eslint src/",
    "lint:src:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "topems": "bash $(cd ../../ && pwd)/scripts/topems.sh",
    "postinstall": "node scripts/postinstall.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "perf": "lighthouse --view http://localhost:5173/ --output=html --output-path=./reports/lighthouse-report.html",
    "perf:ci": "lhci autorun",
    "perf:analyze": "webpack-bundle-analyzer ./dist/stats.json"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
