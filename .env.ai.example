# TOPEMS AI/向量搜索配置

# AI 提供者: ollama, openai, local, mock
AI_PROVIDER=ollama

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VECTOR_DIMENSION=3584

# OpenAI 配置（可选）
OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-small
OPENAI_VECTOR_DIMENSION=1536

# 本地 BGE 配置（可选）
LOCAL_EMBEDDING_ENDPOINT=http://localhost:8080/embed
LOCAL_VECTOR_DIMENSION=1024

# 向量搜索配置
VECTOR_INDEX_PREFIX=topems
VECTOR_SEARCH_LIMIT=10
VECTOR_SIMILARITY_THRESHOLD=0.75

# Redis 向量存储配置
REDIS_VECTOR_INDEX=employee_vectors
REDIS_SKILL_INDEX=skill_vectors
