{
  "name": "topems",
  "version": "5.15.0",
  "description": "TOPEMS - Enterprise Management System with Module Federation",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install && node scripts/patch-react-transition-group.cjs",
    "dev": "./scripts/start-local.sh",
    "dev:web": "pnpm --filter topems-portal dev",
    "dev:core": "pnpm --filter topems-core dev",
    "dev:backend": "./scripts/topems.sh start iam",
    "dev:all": "./scripts/topems.sh start-all",
    "dev:stop": "./scripts/topems.sh stop-all",
    "dev:host": "pnpm --filter topems-portal dev",
    "build:host": "pnpm --filter topems-portal build",
    "build:core": "pnpm --filter topems-core build",
    "build:shared-types": "pnpm --filter @topems/shared-types build",
    "build:shared-utils": "pnpm --filter @topems/shared-utils build",
    "build": "pnpm run build:shared-types && pnpm run build:shared-utils && pnpm run build:core && pnpm run build:host",
    "lint": "eslint apps/ packages/ --max-warnings 100",
    "lint:fix": "eslint apps/ packages/ --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "test": "pnpm --filter topems-portal test",
    "typecheck": "pnpm --filter topems-portal typecheck",
    "topems": "./scripts/topems.sh",
    "install:all": "./scripts/install-deps.sh",
    "generate:tokens": "tsx scripts/generate-tokens.ts",
    "check:design-system": "bash scripts/check-design-system.sh",
    "check:error-handling": "node scripts/ci/check-error-handling.cjs",
    "check:error-handling:changed": "node scripts/ci/check-error-handling.cjs --changed-only",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:design-tokens:ci": "node scripts/ci/check-design-tokens.cjs --strict --changed-only",
    "check:design-tokens:ci-full": "node scripts/ci/check-design-tokens.cjs --strict",
    "audit:design-system": "node scripts/design-system-audit/scan.mjs",
    "gen:types": "node scripts/openapi/gen-types.mjs",
    "gen:api-docs": "bash scripts/openapi/generate.sh",
    "audit:unused": "node scripts/audit/detect-ts-unused-exports.cjs",
    "audit:unused:type-only": "python3 scripts/audit/type-only-scan.py"
  },
  "keywords": [
    "enterprise",
    "management",
    "module-federation",
    "monorepo"
  ],
  "author": "TOPEMS Team",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lefthook": "^2.1.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "recharts@3.10.0": "patches/recharts@3.10.0.patch"
    },
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "undici": "7.29.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "joi": "17.13.7",
      "send": "0.19.2",
      "adm-zip": "0.6.1",
      "@xmldom/xmldom": "0.9.12",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4": "4.3.2",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2": "2.1.7",
      "semver@<7": "7.8.5",
      "tar": "7.5.21",
      "decode-uri-component": "0.5.0",
      "semver@7": "7.8.5",
      "uuid": "11.1.1",
      "image-size": "2.0.3"
    }
  },
  "type": "module"
}
