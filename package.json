{
  "name": "topems",
  "version": "1.0.0",
  "description": "TOPEMS - Enterprise Management System with Module Federation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:host": "pnpm --filter topems-portal dev",
    "dev:core": "pnpm --filter topems-core dev",
    "build:host": "pnpm --filter topems-portal build",
    "build:core": "pnpm --filter topems-core build",
    "build:shared-types": "pnpm --filter @topems/shared-types build",
    "build:shared-utils": "pnpm --filter @topems/shared-utils build",
    "build": "pnpm run build:shared-types && pnpm run build:shared-utils && pnpm run build:core && pnpm run build:host",
    "lint": "pnpm --filter topems-portal lint",
    "test": "pnpm --filter topems-portal test",
    "typecheck": "pnpm --filter topems-portal typecheck"
  },
  "keywords": [
    "enterprise",
    "management",
    "module-federation",
    "monorepo"
  ],
  "author": "TOPEMS Team",
  "license": "MIT",
  "packageManager": "yarn@4.5.0",
  "dependencies": {
    "@react-leaflet/core": "^3.0.0",
    "react-leaflet": "^5.0.0"
  }
}
