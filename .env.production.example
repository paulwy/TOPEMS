# TOPEMS 生产环境配置示例
# 复制此文件为 .env.production 并根据实际情况修改

# 数据库配置
POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
POSTGRES_USER=topems_prod
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=topems_prod

# Redis 配置
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# 数据库连接 URL（由上面的变量自动生成）
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# JWT 密钥 - 在生产环境中必须使用强随机密钥！
JWT_SECRET=change_this_to_a_very_secure_random_key_in_production
JWT_EXPIRATION=86400

# 服务端口
SERVER_PORT=8080
NOTIFICATION_PORT=8081
REPORT_PORT=8082
DOC_PORT=8001
FLOW_PORT=8004
IAM_PORT=8002
LIMS_PORT=8086
QMS_PORT=8087
RS_PORT=8088
EHS_PORT=8089
SRM_PORT=8090
AI_PORT=8003

# 应用配置
RUST_LOG=info
RUST_BACKTRACE=0
FRONTEND_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# 文件上传限制（字节）
MAX_UPLOAD_SIZE=104857600

# 禁用内存模式，强制使用数据库持久化
USE_MEMORY_STORAGE=false

# AI 服务配置（可选）
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3
