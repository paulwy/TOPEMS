# TOPEMS Docker 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ========================
# 数据库配置
# ========================
POSTGRES_USER=topems
POSTGRES_PASSWORD=topems_secret
POSTGRES_DB=topems
POSTGRES_PORT=5432

# ========================
# Redis 配置
# ========================
REDIS_PORT=6379

# ========================
# 服务端口配置
# ========================
IAM_PORT=8002
DOC_PORT=8001
AI_PORT=8003
FLOW_PORT=8004
RS_PORT=8005
LIMS_PORT=8006
QMS_PORT=8007
EHS_PORT=8008
SRM_PORT=8009
PDM_PORT=8010

# ========================
# 前端配置
# ========================
FRONTEND_PORT=3000

# ========================
# Nginx 配置
# ========================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ========================
# JWT 配置（IAM服务）
# ========================
JWT_SECRET=topems-jwt-secret-key-change-in-production-2026
JWT_EXPIRATION_HOURS=24

# ========================
# AI 配置（AI服务）
# ========================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ========================
# 文件存储配置（DOC服务）
# ========================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=104857600

# ========================
# 日志配置
# ========================
RUST_LOG=info

# ========================
# Docker 配置
# ========================
RESTART_POLICY=unless-stopped
