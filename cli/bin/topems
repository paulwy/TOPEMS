#!/bin/bash
# TOPEMS CLI 入口脚本

# 自动检测虚拟环境
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_DIR="$(dirname "$SCRIPT_DIR")"

# 设置 PYTHONPATH（Windows 的 Python 用分号分隔且需 Windows 路径格式）
if [ -n "$MSYSTEM" ] || [ -n "$WINDIR" ]; then
    WIN_SRC=$(cygpath -m "$CLI_DIR/src" 2>/dev/null || echo "$CLI_DIR/src")
    export PYTHONPATH="$WIN_SRC;$PYTHONPATH"
else
    export PYTHONPATH="$CLI_DIR/src:$PYTHONPATH"
fi

VENV_DIR="$CLI_DIR/.venv"

# Windows (Git Bash/MSYS2) 与 Unix 的 venv 结构与命令差异
if [ -n "$MSYSTEM" ] || [ -n "$WINDIR" ]; then
    PY_CMD="${PYTHON_CMD:-python}"
    VENV_ACTIVATE="$VENV_DIR/Scripts/activate"
else
    PY_CMD="${PYTHON_CMD:-python3}"
    VENV_ACTIVATE="$VENV_DIR/bin/activate"
fi

# 创建虚拟环境（如果不存在）
if [[ ! -f "$VENV_ACTIVATE" ]]; then
    echo "创建 Python 虚拟环境 .venv ..."
    "$PY_CMD" -m venv "$VENV_DIR"
fi

# 激活虚拟环境
# shellcheck disable=SC1090
source "$VENV_ACTIVATE"

# 检查依赖
python -c "import yaml, click, rich, httpx" 2>/dev/null || {
    echo "缺少依赖，正在安装..."
    python -m pip install pyyaml click rich httpx --quiet
}

# 运行 CLI
exec python -m topems_cli "$@"
