#!/bin/bash
# TOPEMS CLI 入口脚本

# 自动检测虚拟环境
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_DIR="$(dirname "$SCRIPT_DIR")"

# 设置 PYTHONPATH
export PYTHONPATH="$CLI_DIR/src:$PYTHONPATH"

# 检查是否有虚拟环境
VENV_DIR="$CLI_DIR/.venv"
if [[ -f "$VENV_DIR/bin/activate" ]]; then
    source "$VENV_DIR/bin/activate"
fi

# 检查依赖
python3 -c "import yaml, click, rich, httpx" 2>/dev/null || {
    echo "缺少依赖，正在安装..."
    pip3 install pyyaml click rich httpx --quiet
}

# 运行 CLI
exec python3 -m topems_cli "$@"
