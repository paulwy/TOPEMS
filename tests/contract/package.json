{
  "name": "@topems/contract-tests",
  "version": "1.0.0",
  "description": "TOPEMS API contract tests using Pact",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "pact:publish": "node scripts/publish-contracts.js",
    "pact:verify": "node scripts/verify-contracts.js"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.0.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
