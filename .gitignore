# TOPEMS .gitignore 文件
# ================================

# ================================
# 基础配置
# ================================

# 依赖
node_modules/
pnpm-lock.yaml
yarn.lock

# Rust
target/
Cargo.lock

# 构建输出
dist/
build/

# 日志
logs/
*.log

# 操作系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# ================================
# 环境变量文件（安全配置）
# ================================
# ⚠️ 重要：这些文件包含敏感信息，切勿提交到版本控制

# 主项目
.env
.env.local
.env.*.local
!.env.example        # ✅ 保留环境变量模板
!.env.development   # ✅ 保留开发环境模板
!.env.test          # ✅ 保留测试环境模板
!.env.production    # ✅ 保留生产环境模板（已脱敏）

# 前端项目
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example      # ✅ 保留前端环境变量模板
!frontend/.env.development # ✅ 保留前端开发环境模板
!frontend/.env.test         # ✅ 保留前端测试环境模板
!frontend/.env.production   # ✅ 保留前端生产环境模板

# ================================
# 敏感文件
# ================================

# SSL 证书和密钥
*.pem
*.key
*.crt
ssl/
certs/

# 配置文件
config/secrets.yml
secret.json
credentials.json

# 临时文件
tmp/
temp/
.cache/

# ================================
# 使用说明
# ================================
# 1. 从 .env.example 复制环境变量配置
# 2. 根据实际环境修改敏感信息
# 3. 绝对不要提交包含真实密码/密钥的文件
# 4. 生产环境使用 Kubernetes Secrets 或 Vault 管理敏感信息
