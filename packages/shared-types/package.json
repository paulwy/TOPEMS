{
  "name": "@topems/shared-types",
  "version": "5.14.0",
  "description": "TOPEMS Shared TypeScript Types for Multi-Platform Support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "gen:types": "node ../../scripts/openapi/gen-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "topems",
    "types",
    "shared",
    "multi-platform"
  ],
  "author": "TOPEMS Development Team",
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "eslint": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}