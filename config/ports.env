# TOPEMS 服务端口配置文件 (v7.1)
# 统一管理所有服务的端口号
# ================================================
# 权威端口表来源：config/ports.env
# 此文件与以下文件保持严格一致：
#   - config/services.yaml
#   - scripts/services.conf
#   - scripts/topems.sh
#   - docker/docker-compose.yml
#   - lib/src/config/services.rs
#   - apps/web/vite.config.ts
#   - .env
# ================================================
# 端口分配规则：
#   1. 范围: 8000-8079 业务服务，5432/6379/11434/3000/8080 基础设施
#   2. 策略: 按业务域分组，每 10 个端口预留一个域段
#   3. 编号: 域内从 X0 开始顺序递增
#   4. 首位即主服务: 段首 (X0) 分配给该域的核心服务
#   5. 虚拟服务: 由 unified-core 内部模块提供的服务共用 8000
# ================================================
# 最后更新: 2026-07-20

# ================================================
# 核心服务 (8000-8009)
# unified-core 承载多个虚拟服务，通过 URL 路径区分
# ================================================
CORE_PORT=8000
IAM_PORT=8000
DOC_PORT=8000
FILE_PORT=8000
FLOW_PORT=8000
IM_PORT=8000
MAIL_PORT=8000
NOTIFICATION_PORT=8000

# ================================================
# 经营管理服务 (8010-8019)
# ================================================
ERP_PORT=8010
FINANCE_PORT=8011
DOC_STANDALONE_PORT=8012
AI_PORT=8013

# ================================================
# 协同办公服务 (8020-8029)
# ================================================
HRM_PORT=8020
PM_PORT=8023
CRM_PORT=8029

# ================================================
# 生产制造服务 (8030-8039)
# ================================================
MES_PORT=8030
PDM_PORT=8031

# ================================================
# 供应链服务 (8040-8049)
# ================================================
SCM_PORT=8040
WMS_PORT=8041
SRM_PORT=8042

# ================================================
# 质量/研发服务 (8050-8059)
# ================================================
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
RS_PORT=8053

# ================================================
# 数据分析/门户服务 (8060-8069)
# NOTE: report 功能已整合到 bi 服务中
# ================================================
BI_PORT=8060
MONITOR_PORT=8062
PORTAL_PORT=8063

# ================================================
# 基础设施服务 (8070-8079)
# ================================================
MOBILE_PORT=8070
GIS_PORT=8071
INTEGRATION_PORT=8072

# ================================================
# 数据库端口（内部使用）
# ================================================
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# ================================================
# 前端端口
# ================================================
WEB_PORT=3000

# ================================================
# API网关端口
# ================================================
GATEWAY_PORT=8080
