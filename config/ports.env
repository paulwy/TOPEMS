# TOPEMS 服务端口配置文件 (v7.1)
# 统一管理所有服务的端口号
# ================================================
# 权威端口表来源：config/ports.env（单一信源）
# 下游文件由 scripts/sync-ports.sh 自动生成，请勿手动编辑：
#   - scripts/services.conf
#   - deploy/docker/.env
# 以下文件仍需手动保持一致（含端口外的其他配置）：
#   - config/services.yaml
#   - .env
#   - lib/src/config/services.rs
#   - apps/web/vite.config.ts
# ================================================
# 端口分配规则：
#   1. 范围: 8000-8079 业务服务，5432/6379/11434/3000/8080 基础设施
#   2. 策略: 按业务域分组，每 10 个端口预留一个域段
#   3. 编号: 域内从 X0 开始顺序递增
#   4. 首位即主服务: 段首 (X0) 分配给该域的核心服务
#   5. 虚拟服务: 由 unified-core 内部模块提供的服务共用 8000
# ================================================
# 最后更新: 2026-07-24

# ================================================
# 核心服务 (8000-8009)
# unified-core 承载多个虚拟服务，通过 URL 路径区分
# ================================================
CORE_PORT=8000
IAM_PORT=8000
DOC_PORT=8000
FILE_PORT=8000
FLOW_PORT=8000
MONITOR_PORT=8000

# ================================================
# 通信服务 (8084)
# mail/notification/im 已外迁到 communication 独立服务
# ================================================
COMMUNICATION_PORT=8084

# ================================================
# 搜索服务 (8082)
# 全文搜索服务
# ================================================
SEARCH_PORT=8082

# ================================================
# 计费/工单/反馈服务 (8085-8087)
# 从 unified-core 外迁的独立服务
# ================================================
BILLING_PORT=8085
TICKET_PORT=8086
FEEDBACK_PORT=8087

# ================================================
# 经营管理服务 (8010-8019)
# NOTE: doc 独立服务已合并到 unified-core/doc，端口 8000
# ================================================
ERP_PORT=8010
FINANCE_PORT=8011
AI_PORT=8013

# ================================================
# 协同办公服务 (8020-8029)
# ================================================
HRM_PORT=8020
PM_PORT=8023
CRM_PORT=8029

# ================================================
# 生产制造服务 (8030-8039)
# ================================================
MES_PORT=8030
PDM_PORT=8031

# ================================================
# 供应链服务 (8040-8049)
# ================================================
SCM_PORT=8040
WMS_PORT=8041
SRM_PORT=8042

# ================================================
# 质量/研发服务 (8050-8059)
# ================================================
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
RD_PORT=8053

# ================================================
# 数据分析/门户服务 (8060-8069)
# NOTE: report 功能已整合到 bi 服务中
# NOTE: monitor 独立服务已合并到 unified-core/monitor，端口 8000
# ================================================
BI_PORT=8060
ANALYTICS_PORT=8060
PORTAL_PORT=8063

# ================================================
# 基础设施服务 (8070-8079)
# ================================================
MOBILE_PORT=8070
GIS_PORT=8071
INTEGRATION_PORT=8072

# ================================================
# 低代码平台服务 (8088)
# ================================================
LOWCODE_PORT=8088

# ================================================
# 主数据服务 (8090)
# ================================================
MASTER_DATA_PORT=8090

# ================================================
# 数据库端口（内部使用）
# ================================================
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# ================================================
# 前端端口
# ================================================
WEB_PORT=3000

# ================================================
# API网关端口
# ================================================
GATEWAY_PORT=8080

# ================================================
# Module Federation 前端 Dev Server 端口 (3001-3019)
# 权威表：与 apps/web/src/config/ports.ts 的 MF_PORTS 保持同步
# 下游消费：
#   - apps/web/src/microfrontend/config.ts REMOTE_MODULES（getRemoteEntry 读取）
#   - apps/web/vite.config.ts MF config（开发环境 dev server 端口）
# ================================================
MF_CORE_PORT=3001
MF_ERP_PORT=3002
MF_HRM_PORT=3003
MF_CRM_PORT=3004
MF_SCM_PORT=3005
MF_WMS_PORT=3006
MF_MES_PORT=3007
MF_PM_PORT=3008
MF_FINANCE_PORT=3009
MF_SRM_PORT=3010
MF_PDM_PORT=3011
MF_QMS_PORT=3012
MF_LIMS_PORT=3013
MF_EHS_PORT=3014
MF_BI_PORT=3015
MF_MONITOR_PORT=3016
MF_AI_PORT=3017
MF_GIS_PORT=3018
MF_DOC_PORT=3019
