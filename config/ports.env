# TOPEMS 服务端口配置文件 (v7.0)
# 统一管理所有服务的端口号
# ================================================
# 权威端口表来源：config/ports.env
# 此文件与以下文件保持严格一致：
#   - config/services.yaml
#   - scripts/services.conf
#   - scripts/topems.sh
#   - docker/docker-compose.yml
#   - lib/src/config/services.rs
# ================================================
# 最后更新: 2026-06-24

# ================================================
# 核心服务 (8000-8009)
# ================================================
CORE_PORT=8000
IAM_PORT=8000
DOC_PORT=8000
FILE_PORT=8000
FLOW_PORT=8000
IM_PORT=8000
MAIL_PORT=8000
NOTIFICATION_PORT=8000

# ================================================
# 经营管理服务 (8010-8019)
# ================================================
ERP_PORT=8010
FINANCE_PORT=8011
DOC_PORT=8012
AI_PORT=8013

# ================================================
# 协同办公服务 (8020-8029)
# ================================================
