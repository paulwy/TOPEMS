# =============================================================
# TOPEMS 服务级环境变量通用模板
# =============================================================
# 本模板是所有业务服务的共用环境变量模板。
# 每个服务只需修改下方【服务特定变量】部分，其余变量全部相同。
#
# 使用方法:
#   1. 复制本文件为 <service-name>.env
#   2. 修改下方【服务特定变量】部分
#   3. 服务启动时通过 --env-file 或 source 加载
#
# 服务特定变量对照表（从 config/services.yaml 读取）:
#   服务名     SEARCH_PATH          端口变量名    默认端口
#   ---------- -------------------- ------------- --------
#   ai         ai,shared,public     AI_PORT       8013
#   analytics  analytics,shared,public BI_PORT     8060
#   crm        crm,shared,public    CRM_PORT      8029
#   ehs        ehs,shared,public    EHS_PORT      8052
#   erp        erp,shared,public    ERP_PORT      8010
#   finance    finance,shared,public FINANCE_PORT  8011
#   gis        gis,shared,public    GIS_PORT      8071
#   hrm        hrm,shared,public    HRM_PORT      8020
#   integration integration,shared,public INTEGRATION_PORT 8072
#   lims       lims,shared,public   LIMS_PORT     8051
#   master-data master_data,shared,public MASTER_DATA_PORT 8084
#   mes        mes,shared,public    MES_PORT      8030
#   mobile     mobile,shared,public MOBILE_PORT   8070
#   pdm        pdm,shared,public    PDM_PORT      8031
#   pm         pm,shared,public     PM_PORT       8023
#   portal     portal,shared,public PORTAL_PORT   8063
#   qms        qms,shared,public    QMS_PORT      8050
#   rd         rd,shared,public     RD_PORT       8053
#   scm        scm,shared,public    SCM_PORT      8040
#   srm        srm,shared,public    SRM_PORT      8042
#   unified-core shared,public      CORE_PORT     8000
#   wms        wms,shared,public    WMS_PORT      8041
# =============================================================

# ==================== 服务特定变量（按服务修改）====================
# 示例（以 erp 服务为例）:
#   SEARCH_PATH=erp,shared,public
#   ERP_PORT=8010
SEARCH_PATH=<SERVICE_NAME>,shared,public
<SERVICE_PORT_VAR>=<SERVICE_PORT>
SERVER_HOST=0.0.0.0

# ==================== 数据库配置（所有服务相同）====================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems

# ==================== JWT 配置（所有服务相同）====================
# ---- JWT 密钥安全要求 ----------------------------------------------------
# 生产部署 / 真实环境必须替换！长度 ≥32 字符，不要使用 topems-* 默认前缀：
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export JWT_REFRESH_SECRET=$(openssl rand -hex 32)
# -------------------------------------------------------------------------
JWT_SECRET=<SET_YOUR_OWN_STRONG_SECRET_AT_LEAST_32_CHARS__DO_NOT_USE_TOPEMS_PREFIX>
JWT_REFRESH_SECRET=<SET_YOUR_OWN_REFRESH_SECRET_AT_LEAST_32_CHARS__MUST_BE_DIFFERENT>
JWT_EXPIRATION_HOURS=24

# ==================== IAM 服务配置（所有服务相同）====================
IAM_SERVICE_URL=http://localhost:8000

# ==================== 日志配置（所有服务相同）====================
RUST_LOG=info
RUST_BACKTRACE=1

# ==================== CORS 配置（所有服务相同）====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== Redis 缓存配置（可选，部分服务）====================
# 启用后用于 L2 分布式缓存（L1=moka 进程内，L2=Redis 跨实例共享）
# 未设置时自动降级为纯 L1 模式（不影响服务启动）
# 详见：docs/development/backend/code-standards.md 缓存章节
# REDIS_URL=redis://localhost:6379
