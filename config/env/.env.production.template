# TOPEMS Production Environment Configuration
# Copy this file to /opt/topems/config/.env and customize

# ============================================================================
# Core Configuration
# ============================================================================

# Application environment
ENVIRONMENT=production

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Server host and port (per service)
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection
DATABASE_URL=postgresql://topems:your_password@localhost:5432/topems

# Database pool size
DATABASE_MAX_CONNECTIONS=20

# Database pool timeout (seconds)
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

# Redis connection
REDIS_URL=redis://localhost:6379

# Redis pool size
REDIS_POOL_SIZE=10

# ============================================================================
# Service Ports (统一端口规范 - 与 .env.example 保持一致)
# ============================================================================
# 端口区间划分:
#   8000-8009: 平台核心服务 (unified-core)
#   8010-8019: 经营管理服务
#   8020-8029: 协同办公服务
#   8030-8039: 生产制造服务
#   8040-8049: 供应链服务
#   8050-8059: 质量/研发服务
#   8060-8069: 数据/门户服务
#   8070-8079: 基础设施服务

# 平台核心服务 (unified-core: IAM, Doc, Flow, File, Communication, Monitor)
# 核心服务 (unified-core 承载多个虚拟服务，共用 8000)
CORE_PORT=8000
IAM_PORT=8000
DOC_PORT=8000
FILE_PORT=8000
FLOW_PORT=8000
IM_PORT=8000
MAIL_PORT=8000
NOTIFICATION_PORT=8000
MONITOR_PORT=8000

# 经营管理服务
ERP_PORT=8010
FINANCE_PORT=8011
AI_PORT=8013

# 协同办公服务
HRM_PORT=8020
PM_PORT=8023
CRM_PORT=8029

# 生产制造服务
MES_PORT=8030
PDM_PORT=8031

# 供应链服务
SCM_PORT=8040
WMS_PORT=8041
SRM_PORT=8042

# 质量/研发服务
QMS_PORT=8050
LIMS_PORT=8051
EHS_PORT=8052
RD_PORT=8053

# 数据/门户服务 (report 已整合到 bi)
BI_PORT=8060
PORTAL_PORT=8063

# 基础设施服务
MOBILE_PORT=8070
GIS_PORT=8071
INTEGRATION_PORT=8072

# 主数据服务
MASTER_DATA_PORT=8090

# ============================================================================
# Authentication & Security
# ============================================================================

# ---- JWT 密钥安全要求 ----------------------------------------------------
# 生产部署 / 真实环境必须替换！长度 ≥32 字符，不要使用任何弱默认值：
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export JWT_REFRESH_SECRET=$(openssl rand -hex 32)
# -------------------------------------------------------------------------
JWT_SECRET=<SET_YOUR_OWN_STRONG_SECRET_AT_LEAST_32_CHARS__REQUIRED>
JWT_REFRESH_SECRET=<SET_YOUR_OWN_REFRESH_SECRET_AT_LEAST_32_CHARS__MUST_BE_DIFFERENT>

# JWT expiration (hours)
JWT_EXPIRATION_HOURS=24

# Session secret（独立于 JWT，同样需要 ≥32 字符强随机值）
SESSION_SECRET=<SET_YOUR_OWN_STRONG_SESSION_SECRET_AT_LEAST_32_CHARS>

# CORS allowed origins
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================================================
# File Storage
# ============================================================================

# Storage type (local, s3)
STORAGE_TYPE=local

# Local storage path
STORAGE_PATH=/opt/topems/data/files

# Maximum file size (MB)
MAX_FILE_SIZE_MB=100

# S3 configuration (if STORAGE_TYPE=s3)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ============================================================================
# AI Configuration
# ============================================================================

# Ollama endpoint
OLLAMA_ENDPOINT=http://localhost:11434

# Default AI model
AI_DEFAULT_MODEL=llama3

# Vector store type (postgres, memory)
VECTOR_STORE_TYPE=postgres

# ============================================================================
# Email Configuration
# ============================================================================

# SMTP host
SMTP_HOST=smtp.example.com

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=your_email@example.com

# SMTP password
SMTP_PASSWORD=your_smtp_password

# From address
EMAIL_FROM=noreply@your-domain.com

# ============================================================================
# Monitoring
# ============================================================================

# Prometheus metrics port
METRICS_PORT=9090

# Enable metrics
ENABLE_METRICS=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# ============================================================================
# Tenant Configuration
# ============================================================================

# Default tenant isolation mode (independent, shared)
DEFAULT_TENANT_ISOLATION=shared

# Maximum tenants per instance
MAX_TENANTS=100

# ============================================================================
# Plugin Configuration
# ============================================================================

# Plugin storage path
PLUGIN_STORAGE_PATH=/opt/topems/data/plugins

# Enable plugin marketplace
ENABLE_PLUGIN_MARKETPLACE=true

# 插件注册安全令牌（V13.0 新增，生产环境必须设置）
# 生成方式：openssl rand -hex 32
PLUGIN_REGISTRATION_TOKEN=CHANGE_ME_TO_A_SECURE_RANDOM_TOKEN

# ============================================================================
# Service Discovery (V13.0 新增)
# ============================================================================

# Consul 服务发现（启用后插件通过 Consul 注册与发现）
CONSUL_ENABLED=false
CONSUL_URL=http://consul:8500
CONSUL_TOKEN=

# 服务注册心跳间隔（秒）
SERVICE_HEARTBEAT_INTERVAL=30

# 插件心跳超时阈值（秒，超过此值标记为 offline）
PLUGIN_HEARTBEAT_TIMEOUT=90

# ============================================================================
# Rate Limiting
# ============================================================================

# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# Feature Flags
# ============================================================================

# Enable AI features
ENABLE_AI=true

# Enable GIS features
ENABLE_GIS=true

# Enable mobile features
ENABLE_MOBILE=true