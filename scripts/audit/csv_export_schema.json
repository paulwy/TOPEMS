{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topems.local/schemas/audit/csv_export_schema.json",
  "title": "TOPEMS 审计日志 CSV 导出列结构定义 (P36-4)",
  "description": "定义 generate_audit_report.py --export-logs 导出的三种 CSV 文件的列结构。列顺序与 CSV 表头顺序一致；source_table 指向 PostgreSQL 物理表；sqlx_type 对应 Rust 端 sqlx 类型。所有时间字段以 ISO 8601 / RFC 3339 UTC 输出。",
  "version": "1.0.0",
  "generated_by": "scripts/audit/generate_audit_report.py",
  "encoding": "utf-8",
  "line_terminator": "\n",
  "quoting": "rfc4180",
  "exports": {
    "login_logs": {
      "filename": "login_logs.csv",
      "source_table": "core_login_logs",
      "description": "用户登录日志（成功/失败、IP、UA、错误信息）",
      "max_rows_per_export": 100000,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "sqlx_type": "Uuid",
          "nullable": false,
          "description": "登录日志主键"
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "sqlx_type": "Uuid",
          "nullable": false,
          "description": "租户 ID"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "sqlx_type": "Option<Uuid>",
          "nullable": true,
          "description": "用户 ID（未登录失败时可能为空）"
        },
        {
          "name": "username",
          "type": "string",
          "sqlx_type": "String",
          "nullable": false,
          "max_length": 64,
          "description": "用户名"
        },
        {
          "name": "ip_address",
          "type": "string",
          "sqlx_type": "String",
          "nullable": false,
          "max_length": 128,
          "description": "登录 IP 地址"
        },
        {
          "name": "user_agent",
          "type": "string",
          "sqlx_type": "Option<String>",
          "nullable": true,
          "description": "客户端 User-Agent"
        },
        {
          "name": "status",
          "type": "string",
          "sqlx_type": "String",
          "nullable": false,
          "max_length": 32,
          "description": "登录状态（success / failed / locked 等）"
        },
        {
          "name": "error_message",
          "type": "string",
          "sqlx_type": "Option<String>",
          "nullable": true,
          "description": "失败原因"
        },
        {
          "name": "login_time",
          "type": "timestamp",
          "sqlx_type": "DateTime<Utc>",
          "nullable": false,
          "format": "rfc3339",
          "description": "登录发生时间（UTC）"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "sqlx_type": "DateTime<Utc>",
          "nullable": false,
          "format": "rfc3339",
          "description": "记录创建时间（UTC）"
        }
      ]
    },
    "operation_logs": {
      "filename": "operation_logs.csv",
      "source_table": "core_operation_logs",
      "description": "业务写操作审计日志（创建/更新/删除）",
      "max_rows_per_export": 100000,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "description": "操作日志主键"
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "nullable": false,
          "description": "租户 ID"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "nullable": true,
          "description": "操作用户 ID"
        },
        {
          "name": "user_name",
          "type": "string",
          "nullable": false,
          "max_length": 128,
          "description": "操作用户名"
        },
        {
          "name": "module",
          "type": "string",
          "nullable": false,
          "max_length": 64,
          "description": "业务模块（iam / wms / mes / crm 等）"
        },
        {
          "name": "operation",
          "type": "string",
          "nullable": false,
          "max_length": 32,
          "description": "操作类型（create / update / delete 等）"
        },
        {
          "name": "resource_type",
          "type": "string",
          "nullable": false,
          "max_length": 64,
          "description": "资源类型"
        },
        {
          "name": "resource_id",
          "type": "string",
          "nullable": true,
          "max_length": 128,
          "description": "资源 ID"
        },
        {
          "name": "description",
          "type": "string",
          "nullable": true,
          "description": "操作描述"
        },
        {
          "name": "request_data",
          "type": "json",
          "nullable": true,
          "description": "请求数据快照（JSONB 序列化为单行 JSON 字符串）"
        },
        {
          "name": "response_status",
          "type": "integer",
          "nullable": true,
          "description": "HTTP 响应状态码"
        },
        {
          "name": "ip_address",
          "type": "string",
          "nullable": true,
          "max_length": 128,
          "description": "操作来源 IP"
        },
        {
          "name": "user_agent",
          "type": "string",
          "nullable": true,
          "description": "客户端 User-Agent"
        },
        {
          "name": "trace_id",
          "type": "string",
          "nullable": true,
          "max_length": 64,
          "description": "分布式追踪 ID（OTel trace-id）"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "nullable": false,
          "format": "rfc3339",
          "description": "操作发生时间（UTC）"
        }
      ]
    },
    "permission_changes": {
      "filename": "permission_changes.csv",
      "source_table": "iam.permission_audit_logs",
      "description": "权限/角色变更审计日志（分配/撤销/更新）",
      "max_rows_per_export": 100000,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "description": "权限变更日志主键"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "nullable": true,
          "description": "操作目标用户 ID"
        },
        {
          "name": "username",
          "type": "string",
          "nullable": true,
          "description": "操作目标用户名"
        },
        {
          "name": "target_user_id",
          "type": "uuid",
          "nullable": true,
          "description": "被授权用户 ID"
        },
        {
          "name": "target_user_name",
          "type": "string",
          "nullable": true,
          "description": "被授权用户名"
        },
        {
          "name": "role_id",
          "type": "uuid",
          "nullable": true,
          "description": "角色 ID"
        },
        {
          "name": "role_name",
          "type": "string",
          "nullable": true,
          "description": "角色名称"
        },
        {
          "name": "permission_id",
          "type": "uuid",
          "nullable": true,
          "description": "权限点 ID"
        },
        {
          "name": "permission_name",
          "type": "string",
          "nullable": true,
          "description": "权限点名称"
        },
        {
          "name": "permission_code",
          "type": "string",
          "nullable": true,
          "description": "权限点代码"
        },
        {
          "name": "action",
          "type": "string",
          "nullable": false,
          "description": "操作类型（grant / revoke / update 等）"
        },
        {
          "name": "change_type",
          "type": "string",
          "nullable": false,
          "description": "变更类型（role / permission 等）"
        },
        {
          "name": "operator_id",
          "type": "uuid",
          "nullable": false,
          "description": "操作人用户 ID"
        },
        {
          "name": "operator_name",
          "type": "string",
          "nullable": false,
          "description": "操作人用户名"
        },
        {
          "name": "ip_address",
          "type": "string",
          "nullable": true,
          "description": "操作来源 IP"
        },
        {
          "name": "reason",
          "type": "string",
          "nullable": true,
          "description": "变更原因说明"
        },
        {
          "name": "success",
          "type": "boolean",
          "nullable": false,
          "description": "变更是否成功"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "nullable": false,
          "format": "rfc3339",
          "description": "变更发生时间（UTC）"
        }
      ]
    }
  },
  "notes": [
    "CSV 表头顺序与各 columns 数组顺序严格一致。",
    "可空字段在 CSV 中以空字符串表示（不使用 NULL 字面量）。",
    "request_data (JSONB) 序列化为单行紧凑 JSON 后按 RFC 4180 转义。",
    "所有 timestamp 字段以 RFC 3339 / ISO 8601 UTC 输出（带 Z 后缀）。",
    "布尔字段输出 true / false 小写字面量。",
    "单次导出行数上限由 max_rows_per_export 控制；超出建议按时间分片导出。"
  ]
}
