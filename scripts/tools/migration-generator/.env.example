# TOPEMS 数据库迁移工具环境变量配置示例

# PostgreSQL 数据库连接 URL
# 格式: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topems

# 迁移文件输出目录（可选，默认为 ./migrations）
MIGRATIONS_DIR=./migrations

# 迁移表名（可选，默认为 schema_migrations）
MIGRATIONS_TABLE=schema_migrations
