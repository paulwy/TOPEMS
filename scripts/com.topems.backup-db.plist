<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.topems.backup-db</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xingzhai/topems/scripts/backup-db.sh</string>
    </array>

    <!-- 每天凌晨 3:00 执行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/Users/xingzhai/topems/logs/backup-db.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xingzhai/topems/logs/backup-db.err.log</string>

    <!-- 后台运行 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
