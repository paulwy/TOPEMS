  "query": "\n        SELECT id, name, rule_type, condition\n        FROM analytics_row_level_permissions\n        WHERE datasource_id = $1\n          AND table_name = $2\n          AND is_active = true\n          AND (\n            user_ids @> $3::text[]\n            OR role_ids && $4::text[]\n            OR (user_ids IS NULL AND role_ids IS NULL)\n          )\n          AND ($5::uuid IS NULL OR tenant_id = $5::uuid)\n        ",
