  "query": "\n        UPDATE process_routes\n        SET \n            name = COALESCE($1, name),\n            description = COALESCE($2, description),\n            status = COALESCE($3, status),\n            updated_at = NOW()\n        WHERE id = $4\n        RETURNING id, code, name, description, status,\n            created_at, updated_at\n        ",
