  "query": "\n        SELECT id, comparison_id, status, data, summary, generated_at\n        FROM analytics_comparison_results\n        WHERE comparison_id = $1\n          AND ($2::uuid IS NULL OR tenant_id = $2::uuid)\n        ORDER BY generated_at DESC\n        LIMIT 1\n        ",
