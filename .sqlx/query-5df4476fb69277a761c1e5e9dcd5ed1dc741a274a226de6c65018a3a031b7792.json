{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            pfs.id, pfs.sequence, pfs.standard_time,\n            pp.name as process_name\n        FROM process_flow_steps pfs\n        LEFT JOIN production_processes pp ON pfs.process_id = pp.id\n        WHERE pfs.flow_id = $1\n        ORDER BY pfs.sequence ASC\n        ",
