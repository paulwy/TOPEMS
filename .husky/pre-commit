#!/usr/bin/env sh

echo "🔍 Running pre-commit checks..."

ERRORS=0

# 获取暂存的文件列表
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ============================================================
# 1. 检查大文件 (>1MB)
# ============================================================
echo ""
echo "📦 Checking for large files (>1MB)..."
LARGE_FILES=""
MAX_SIZE=1048576

for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    # 排除 lock 文件和数据库文件
    case "$file" in
      pnpm-lock.yaml|*-lock.yaml|database/postgres_data/*)
        continue
        ;;
    esac

    # Git LFS 管理的文件在工作区仍是完整文件，但提交对象会被 clean
    # filter 转换为 LFS pointer。此类文件不应触发普通大文件检查。
    LFS_FILTER=$(git check-attr filter -- "$file" 2>/dev/null | awk -F': ' '{print $3}')
    if [ "$LFS_FILTER" = "lfs" ]; then
      continue
    fi

    FILE_SIZE=$(wc -c < "$file")
    if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
      SIZE_KB=$((FILE_SIZE / 1024))
      LARGE_FILES="$LARGE_FILES  - $file (${SIZE_KB}KB)\n"
    fi
  fi
done

if [ -n "$LARGE_FILES" ]; then
  echo "❌ Large files detected:"
  printf "$LARGE_FILES"
  echo ""
  echo "   Please remove these files or use Git LFS instead."
  ERRORS=$((ERRORS + 1))
else
  echo "✅ No large files detected"
fi

# ============================================================
# 2. 检查敏感信息（简单正则检查）
# ============================================================
echo ""
echo "🔐 Checking for sensitive information..."

SENSITIVE_PATTERNS=(
  "password\s*=\s*['\"][^'\"]+['\"]"
  "secret\s*=\s*['\"][^'\"]+['\"]"
  "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
  "private[_-]?key\s*=\s*['\"][^'\"]+['\"]"
  "token\s*=\s*['\"][^'\"]+['\"]"
  "AWS_ACCESS_KEY_ID\s*=\s*['\"][A-Z0-9]{16,}['\"]"
  "AWS_SECRET_ACCESS_KEY\s*=\s*['\"][A-Za-z0-9/+=]{40,}['\"]"
  "-----BEGIN PRIVATE KEY-----"
  "-----BEGIN RSA PRIVATE KEY-----"
)

SENSITIVE_FILES=""

for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    case "$file" in
      *.key|*.pem|*.p12|*.pfx)
        SENSITIVE_FILES="$SENSITIVE_FILES  - $file (potential key/cert file)\n"
        continue
        ;;
    esac
    
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
      if grep -qiE "$pattern" "$file" 2>/dev/null; then
        SENSITIVE_FILES="$SENSITIVE_FILES  - $file (matched: $pattern)\n"
        break
      fi
    done
  fi
done

if [ -n "$SENSITIVE_FILES" ]; then
  echo "⚠️  Potential sensitive information detected in:"
  printf "$SENSITIVE_FILES"
  echo ""
  echo "   Please review and ensure no real secrets are being committed."
  echo "   If this is a false positive, you can skip this check with --no-verify"
else
  echo "✅ No sensitive information detected"
fi

# ============================================================
# 3. 运行 lint-staged（按文件类型检查）
# ============================================================
echo ""
echo "🎨 Running lint-staged (eslint, prettier, cargo fmt)..."

npx lint-staged
LINT_STAGED_EXIT=$?

if [ $LINT_STAGED_EXIT -ne 0 ]; then
  echo "❌ lint-staged failed"
  ERRORS=$((ERRORS + 1))
else
  echo "✅ lint-staged passed"
fi

# ============================================================
# 4. API 路径检查（仅当有后端 Rust 文件变更时）
# ============================================================
echo ""
echo "🔗 Checking API path duplicates..."

HAS_RS_FILES=$(echo "$STAGED_FILES" | grep -E "^svc/.*\.rs$" | head -1)

if [ -n "$HAS_RS_FILES" ]; then
  # 检查脚本是否存在
  if [ -f "scripts/check_api_duplicates_ci.py" ]; then
    python3 scripts/check_api_duplicates_ci.py --ci
    API_EXIT=$?

    if [ $API_EXIT -ne 0 ]; then
      echo "❌ API path check failed"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ API path check passed"
    fi
  else
    echo "⏭️  Skipped (check_api_duplicates_ci.py not found)"
  fi
else
  echo "⏭️  Skipped (no Rust backend files staged)"
fi

# ============================================================
# 5. V64 页面标准化审计（仅检查新建的 CRUD 页面）
# ============================================================
echo ""
echo "📐 Checking page standardization (V64)..."

HAS_NEW_PAGES=$(echo "$STAGED_FILES" | grep -E "^apps/web/src/pages/.*\.tsx$" | grep -v ".test.tsx" | head -1)

if [ -n "$HAS_NEW_PAGES" ]; then
  if [ -f "scripts/ci/page-audit.cjs" ]; then
    node scripts/ci/page-audit.cjs --diff --strict
    PAGE_AUDIT_EXIT=$?
    if [ $PAGE_AUDIT_EXIT -ne 0 ]; then
      echo "⚠️  新建 CRUD 页面未使用标准模板（CrudPage/ListPageTemplate）"
      echo "   参考：apps/web/src/pages/admin/TenantManagementPage.tsx"
      # V64 阶段：先警告不阻断，后续可改为 ERRORS=$((ERRORS + 1))
    else
      echo "✅ Page standardization check passed"
    fi
  else
    echo "⏭️  Skipped (page-audit.cjs not found)"
  fi
else
  echo "⏭️  Skipped (no new page files staged)"
fi

# ============================================================
# 6. V64 图标完整性检查（仅当 iconMapping 或 modules/config 变更时）
# ============================================================
echo ""
echo "🎨 Checking icon completeness (V64)..."

HAS_ICON_CHANGES=$(echo "$STAGED_FILES" | grep -E "(^apps/web/src/lib/iconMapping\.tsx$|^apps/web/src/modules/[^/]+/config\.ts$|^apps/web/src/lib/navigation/types\.ts$)" | head -1)

if [ -n "$HAS_ICON_CHANGES" ]; then
  if [ -f "scripts/ci/check-icons.cjs" ]; then
    node scripts/ci/check-icons.cjs --strict
    ICON_CHECK_EXIT=$?
    if [ $ICON_CHECK_EXIT -ne 0 ]; then
      echo "❌ Icon completeness check failed"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ Icon completeness check passed"
    fi
  else
    echo "⏭️  Skipped (check-icons.cjs not found)"
  fi
else
  echo "⏭️  Skipped (no icon-related files staged)"
fi

# ============================================================
# 7. CRM 契约一致性检查（仅当 CRM 相关文件变更时）
# ============================================================
echo ""
echo "📝 Checking CRM contract consistency..."

HAS_CRM_FILES=$(echo "$STAGED_FILES" | grep -E "(^apps/web/src/schemas/crm/|^apps/web/src/api/crm/|^svc/crm/src/(models|modules)/customer)" | head -1)

if [ -n "$HAS_CRM_FILES" ]; then
  if [ -f "scripts/dev/check-crm-contract.mjs" ]; then
    node scripts/dev/check-crm-contract.mjs
    CRM_CONTRACT_EXIT=$?
    if [ $CRM_CONTRACT_EXIT -ne 0 ]; then
      echo "❌ CRM contract verification failed"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ CRM contract verification passed"
    fi
  else
    echo "⏭️  Skipped (check-crm-contract.mjs not found)"
  fi
else
  echo "⏭️  Skipped (no CRM entity files staged)"
fi

# ============================================================
# 8. i18n 质量检查（R11 Z-P1）— 假 en 值 + 源码硬编码中文
# ============================================================
echo ""
echo "🌐 Checking i18n quality (R11 Z-P1)..."

HAS_I18N_FILES=$(echo "$STAGED_FILES" | grep -E "(^apps/web/src/i18n/|^apps/web/src/pages/.*\.tsx$|^scripts/i18n/)" | head -1)

if [ -n "$HAS_I18N_FILES" ]; then
  # 8a. en.json 假 en 值 / 混合结构门禁
  if [ -f "scripts/ci/check-i18n-quality.cjs" ]; then
    node scripts/ci/check-i18n-quality.cjs --strict
    I18N_QUALITY_EXIT=$?
    if [ $I18N_QUALITY_EXIT -ne 0 ]; then
      echo "❌ i18n quality gate failed (fake EN / mixed structure)"
      echo "   修复假 en 值: node scripts/i18n/audit_fake_en.js"
      echo "   修复混合结构: node scripts/i18n/sync_flat_nested.js"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ i18n quality gate passed (fake EN + mixed structure)"
    fi
  else
    echo "⏭️  Skipped (check-i18n-quality.cjs not found)"
  fi

  # 8b. 源码硬编码中文（admin 模块严格清零）
  if [ -f "scripts/ci/check-i18n.cjs" ]; then
    node scripts/ci/check-i18n.cjs --strict
    I18N_HARDCODE_EXIT=$?
    if [ $I18N_HARDCODE_EXIT -ne 0 ]; then
      echo "❌ Hardcoded CJK text detected in admin module TSX files"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ No hardcoded CJK text in admin TSX (strict scope)"
    fi
  else
    echo "⏭️  Skipped (check-i18n.cjs not found)"
  fi

  # 8c. Glossary TopN 术语一致性
  if [ -f "scripts/ci/verify-glossary.cjs" ]; then
    node scripts/ci/verify-glossary.cjs --strict
    GLOSSARY_EXIT=$?
    if [ $GLOSSARY_EXIT -ne 0 ]; then
      echo "❌ Glossary TopN 术语存在非标准译法"
      echo "   修复：运行 node scripts/i18n/apply_glossary.js 自动对齐"
      ERRORS=$((ERRORS + 1))
    else
      echo "✅ Glossary TopN 术语一致性通过"
    fi
  else
    echo "⏭️  Skipped (verify-glossary.cjs not found)"
  fi

  # 8d. 源码硬编码中文（Precise scan · 仅 staged TS/TSX）
  if [ -f "scripts/i18n/scan-hardcoded-precise.cjs" ]; then
    STAGED_TS_TSX=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx)$" | tr '\n' ' ')
    if [ -n "$STAGED_TS_TSX" ]; then
      # shellcheck disable=SC2086
      node scripts/i18n/scan-hardcoded-precise.cjs --strict --details 30 $STAGED_TS_TSX
      HC_EXIT=$?
      if [ $HC_EXIT -ne 0 ]; then
        echo "❌ Precise scan 检测到硬编码中文，请用 i18n.t() 包装"
        ERRORS=$((ERRORS + 1))
      else
        echo "✅ Precise scan：staged TS/TSX 无硬编码中文"
      fi
    else
      echo "⏭️  Skipped (no TS/TSX files staged)"
    fi
  else
    echo "⏭️  Skipped (scan-hardcoded-precise.cjs not found)"
  fi
else
  echo "⏭️  Skipped (no i18n locale / page TSX files staged)"
fi

# ============================================================
# 9. 权限矩阵三向验证（Perm-Gate）— DRY-RUN only，仅 Integrity 级红
# ============================================================
echo ""
echo "🛂 Checking permission matrix 3-way gate (dry-run)..."

# 触发条件：后端路由文件 / 前端导航配置 / PERMISSIONS 定义 / 权限中间件变更
HAS_PERM_FILES=$(echo "$STAGED_FILES" | grep -E "(^svc/.*\.rs$|^lib/shared-auth/.*\.rs$|^apps/web/src/modules/[^/]+/config\.ts$|^apps/web/src/lib/navigation/|^apps/web/src/config/permissions\.ts$|^apps/web/src/lib/routes/v2\.tsx$)" | head -1)

if [ -n "$HAS_PERM_FILES" ]; then
  if [ -f "scripts/ci/check-permission-matrix.cjs" ]; then
    # Pre-commit: ALWAYS dry-run. Never block for R1/R2/R3/R4/R5/R6 count
    # — blocking reserved for CI-level --fail-fast only.
    node scripts/ci/check-permission-matrix.cjs --dry-run --report-json=/tmp/.perm-gate-precommit.json
    PERM_EXIT=$?
    if [ $PERM_EXIT -eq 2 ]; then
      echo "❌ Perm-Gate INTEGRITY FAILED (扫描器覆盖度不足 · regex/path 疑似损坏)"
      echo "   请检查 svc/ lib/shared-auth/ apps/web/src/modules/*/config.ts 路径是否存在"
      echo "   或联系平台组修复 scripts/ci/check-permission-matrix.cjs"
      ERRORS=$((ERRORS + 1))
    elif [ $PERM_EXIT -eq 0 ]; then
      echo "✅ Perm-Gate dry-run passed (Integrity OK)"
      echo "   提示：R1/R2/R3 违规数字若增加，CI --fail-fast 将直接阻断合并"
      echo "   查看当前基线: cat docs/roadmap/artifacts/rN-perm-matrix-baseline.json"
    else
      # 其他 exit 仅警告
      echo "⚠️  Perm-Gate reported exit=$PERM_EXIT (CI 阶段会以 --fail-fast 严格执行)"
    fi
  else
    echo "⏭️  Skipped (check-permission-matrix.cjs not found)"
  fi
else
  echo "⏭️  Skipped (no backend routes / frontend nav / PERMISSIONS table files staged)"
fi

# ============================================================
# 10. Axum 中间件层序校验（Layer-Order Gate · Gate M）— DRY-RUN only
# ============================================================
echo ""
echo "🧱 Checking Axum layer order (Gate M · dry-run)..."

# 触发条件：后端 Rust 文件（lib/ svc/）或 CI 脚本变更
HAS_RUST_OR_CI_FILES=$(echo "$STAGED_FILES" | grep -E "(^svc/.*\.rs$|^lib/.*\.rs$|^Cargo\.(toml|lock)$|^scripts/ci/check-axum-layer-order\.cjs$)" | head -1)

if [ -n "$HAS_RUST_OR_CI_FILES" ]; then
  if [ -f "scripts/ci/check-axum-layer-order.cjs" ]; then
    # Pre-commit: ALWAYS dry-run. Never block (exit=0 always).
    # CI level will enforce --fail-fast once R3 false positives are eliminated.
    node scripts/ci/check-axum-layer-order.cjs --report-json=/tmp/.axum-layer-precommit.json
    AXUM_EXIT=$?
    if [ $AXUM_EXIT -eq 0 ]; then
      echo "✅ Axum Layer-Order dry-run passed (Integrity OK)"
      echo "   提示：R1（层序反序=tenant 在 auth 之后 → 500 Missing Claims）若 ≥1，CI DRY-RUN 也会醒目红榜"
      echo "   R2（只有 auth 无 tenant）/ R3（只有 tenant 无 auth，build_application 模式假阳性）为 WARN，不阻断"
    else
      echo "⚠️  Axum Layer-Order reported exit=$AXUM_EXIT (CI 阶段 DRY-RUN 也始终 exit=0；FAIL 见 Step Summary)"
    fi
  else
    echo "⏭️  Skipped (check-axum-layer-order.cjs not found)"
  fi
else
  echo "⏭️  Skipped (no Rust lib/svc / axum-layer-checker files staged)"
fi

# ============================================================
# 总结
# ============================================================
echo ""
echo "========================================"
if [ $ERRORS -eq 0 ]; then
  echo "✅ All pre-commit checks passed!"
  echo "========================================"
  exit 0
else
  echo "❌ Pre-commit checks failed with $ERRORS error(s)"
  echo "========================================"
  echo ""
  echo "Please fix the issues above and try again."
  echo "To skip these checks (not recommended), use: git commit --no-verify"
  exit 1
fi
