  "query": "\n        SELECT bi.material_code, bi.material_name, bi.specification, bi.unit, bi.quantity\n        FROM bom_items bi\n        JOIN material_boms mb ON bi.bom_id = mb.id\n        WHERE mb.product_code = $1\n        ",
