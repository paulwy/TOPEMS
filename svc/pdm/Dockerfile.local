FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

RUN addgroup -S topems && adduser -S topems -G topems

WORKDIR /app

COPY target/release/topems-pdm /usr/local/bin/topems-pdm

RUN chown -R topems:topems /usr/local/bin

USER topems

ENV PDM_PORT=8031
ENV RUST_LOG=info

EXPOSE 8031

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8031/health || exit 1

