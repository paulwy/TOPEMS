# TOPEMS BI 服务环境变量配置
# 复制此文件为 .env 并根据实际环境修改

# ==================== 数据库配置 ====================
DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems
SEARCH_PATH=bi, shared, public

# ==================== 服务配置 ====================
PORT=8059
SERVER_HOST=0.0.0.0

# ==================== JWT 配置 ====================
JWT_SECRET=topems-jwt-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24

# ==================== IAM 服务配置 ====================
IAM_SERVICE_URL=http://localhost:8000

# ==================== 下游服务配置 ====================
RS_SERVICE_URL=http://localhost:8015
LIMS_SERVICE_URL=http://localhost:8023
QMS_SERVICE_URL=http://localhost:8022
EHS_SERVICE_URL=http://localhost:8056
SRM_SERVICE_URL=http://localhost:8054
PDM_SERVICE_URL=http://localhost:8027

# ==================== 日志配置 ====================
RUST_LOG=info
RUST_BACKTRACE=1

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
