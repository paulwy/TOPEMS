{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, tenant_id, warehouse_id,\n               CASE WHEN $2 = 'en' THEN COALESCE(name_en, name) ELSE name END AS name,\n               zone_type, location_ids, is_active, created_at\n        FROM wms.slotting_zones\n        WHERE ($1::uuid IS NULL OR warehouse_id = $1)\n        ORDER BY created_at\n        ",
