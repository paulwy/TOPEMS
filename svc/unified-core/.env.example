# topems-unified-core 环境配置模板（复制为 .env 使用）
# 敏感值（DATABASE_URL 等）请勿提交，本地按需填写。

# ===== 权限存储配置（PermissionStoreFactory::from_env 读取）=====
# PERMISSION_STORE_TYPE: memory（默认，单实例）| database（PostgreSQL 持久化，多实例）
# PERMISSION_STORE_CACHE_TTL: 数据库缓存 TTL（秒），默认 300
# PERMISSION_STORE_SEED_DEFAULTS: 启动时播种默认权限（默认 true）
PERMISSION_STORE_TYPE=memory
PERMISSION_STORE_CACHE_TTL=300
PERMISSION_STORE_SEED_DEFAULTS=true
