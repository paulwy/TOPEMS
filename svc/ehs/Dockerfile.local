FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

RUN addgroup -S topems && adduser -S topems -G topems

WORKDIR /app

COPY target/release/topems-ehs /usr/local/bin/topems-ehs

RUN chown -R topems:topems /usr/local/bin

USER topems

ENV EHS_PORT=8052
ENV RUST_LOG=info,service_discovery=info,rd::ai_integration=info,portal::federation_gateway=debug,portal::graphql_schema=debug,portal::intelligent_gateway=debug

EXPOSE 8052

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost: