# ============================================
# TOPEMS Report Service - 配置模板
# ============================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8053

DATABASE_URL=postgres://topems:topems_secret@localhost:5432/topems_report

REDIS_URL=redis://localhost:6379

# JWT 配置
# ⚠️ 安全警告：生产环境必须设置强密钥（至少32字符）
# 使用强随机密钥，例如：openssl rand -base64 32
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key-at-least-32-characters
JWT_EXPIRES_IN=86400

RUST_LOG=info,topems_report=info
RUST_BACKTRACE=1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
