# Server Configuration
SERVER_PORT=8003

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/topems

# LLM Configuration - OpenAI/OpenAI-compatible API
OPENAI_API_KEY=your_api_key_here
