# TOPEMS pdm Service Dockerfile - Static Build
# 使用 musl 进行静态编译

# 阶段1: 构建阶段
FROM rust:1.75-slim AS builder

WORKDIR /build

# 安装 musl 工具链
RUN apt-get update && apt-get install -y \
    musl-tools \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 添加 musl 目标
RUN rustup target add x86_64-unknown-linux-musl

# 设置环境变量
ENV PKG_CONFIG_ALLOW_CROSS=1 \
    OPENSSL_STATIC=1 \
    OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu \
    OPENSSL_INCLUDE_DIR=/usr/include

COPY Cargo.toml ./
COPY src/ ./src/

# 静态编译
RUN cargo build --release --target x86_64-unknown-linux-musl

# 阶段2: 运行阶段（使用 scratch 或 alpine）
FROM debian:bookworm-slim

# 安装必要的 CA 证书
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制静态编译的二进制文件
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/topems-pdm /app/

# 创建日志目录
RUN mkdir -p /app/logs

EXPOSE 8010

ENV RUST_LOG=info \
    SERVICE_PORT=8010

ENTRYPOINT ["/app/topems-pdm"]
CMD ["--host", "0.0.0.0", "--port", "8010"]
