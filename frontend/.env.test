# TOPEMS 前端测试环境配置
# ================================
# 此文件用于 CI/CD 和自动化测试

# API 配置
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=10000

# WebSocket 配置
VITE_WS_URL=ws://localhost:8080
VITE_WS_RECONNECT_INTERVAL=1000
VITE_WS_MAX_RECONNECT_ATTEMPTS=3

# 服务端口配置
VITE_IAM_SERVICE_URL=http://localhost:8002
VITE_DOC_SERVICE_URL=http://localhost:8001
VITE_AI_SERVICE_URL=http://localhost:8003
VITE_FLOW_SERVICE_URL=http://localhost:8004
VITE_EHS_SERVICE_URL=http://localhost:8005
VITE_LIMS_SERVICE_URL=http://localhost:8006
VITE_PDM_SERVICE_URL=http://localhost:8007
VITE_QMS_SERVICE_URL=http://localhost:8008
VITE_RS_SERVICE_URL=http://localhost:8009
VITE_SRM_SERVICE_URL=http://localhost:8010
VITE_ERP_SERVICE_URL=http://localhost:8011
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8012
VITE_REPORT_SERVICE_URL=http://localhost:8013

# 功能开关
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_HOT_RELOAD=false
VITE_ENABLE_API_DOCS=true
VITE_ENABLE_MOCK_DATA=false

# OAuth 配置
VITE_OAUTH_GITHUB_ENABLED=false
VITE_OAUTH_GOOGLE_ENABLED=false

# AI 配置
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:7b-instruct

# 文件上传配置
VITE_MAX_UPLOAD_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,pdf,txt,csv

# 日志配置
VITE_LOG_LEVEL=warn
VITE_ENABLE_ERROR_TRACKING=false

# 主题配置
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=false

# 国际化配置
VITE_DEFAULT_LOCALE=en-US
VITE_FALLBACK_LOCALE=en-US
VITE_SUPPORTED_LOCALES=en-US

# 性能配置
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=
VITE_VISUALIZATION_LIBRARY=d3

# 安全配置
VITE_CSRF_TOKEN_URL=/api/csrf-token
VITE_SESSION_TIMEOUT=30

# 第三方服务
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=
