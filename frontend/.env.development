# TOPEMS 前端开发环境配置
# ================================
# 此文件用于本地开发
# VITE_ 前缀是 Vite 框架的要求，用于在客户端代码中暴露环境变量

# API 配置
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=30000

# WebSocket 配置
VITE_WS_URL=ws://localhost:8080
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# 服务端口配置
VITE_IAM_SERVICE_URL=/iam
VITE_RS_SERVICE_URL=http://localhost:8003
VITE_LIMS_SERVICE_URL=http://localhost:8005
VITE_QMS_SERVICE_URL=http://localhost:8012
VITE_MES_SERVICE_URL=http://localhost:8013
VITE_ERP_SERVICE_URL=http://localhost:8008
VITE_SCM_SERVICE_URL=http://localhost:8014
VITE_WMS_SERVICE_URL=http://localhost:8015
VITE_CRM_SERVICE_URL=http://localhost:8009
VITE_HRM_SERVICE_URL=http://localhost:8018
VITE_GIS_SERVICE_URL=http://localhost:8019
VITE_BI_SERVICE_URL=http://localhost:8020
VITE_EHS_SERVICE_URL=http://localhost:8016
VITE_PDM_SERVICE_URL=http://localhost:8017
VITE_SRM_SERVICE_URL=http://localhost:8021
VITE_IM_SERVICE_URL=http://localhost:8022
VITE_AI_SERVICE_URL=/ai
VITE_MOBILE_SERVICE_URL=http://localhost:8024
VITE_INTEGRATION_SERVICE_URL=http://localhost:8025
VITE_PORTAL_SERVICE_URL=http://localhost:8026
VITE_DOC_SERVICE_URL=/doc
VITE_FLOW_SERVICE_URL=/flow
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8023
VITE_REPORT_SERVICE_URL=http://localhost:8024

# 功能开关
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_API_DOCS=true
VITE_ENABLE_MOCK_DATA=false

# OAuth 配置
VITE_OAUTH_GITHUB_ENABLED=false
VITE_OAUTH_GOOGLE_ENABLED=false

# AI 配置
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:7b-instruct

# 文件上传配置
VITE_MAX_UPLOAD_SIZE=104857600
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip,rar

# 日志配置
VITE_LOG_LEVEL=debug
VITE_ENABLE_ERROR_TRACKING=false

# 主题配置
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# 国际化配置
VITE_DEFAULT_LOCALE=zh-CN
VITE_FALLBACK_LOCALE=en-US
VITE_SUPPORTED_LOCALES=zh-CN,en-US,ja-JP

# 性能配置
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=
VITE_VISUALIZATION_LIBRARY=d3

# 安全配置
VITE_CSRF_TOKEN_URL=/api/csrf-token
VITE_SESSION_TIMEOUT=120

# 第三方服务
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=
