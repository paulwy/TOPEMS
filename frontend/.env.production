# TOPEMS 前端生产环境配置
# ================================
# ⚠️ 重要安全提示：
# 1. 此文件包含敏感信息，切勿提交到版本控制
# 2. 所有敏感信息必须通过环境变量或安全配置服务读取
# 3. 生产环境建议使用 CDN 和代码分割优化性能

# API 配置
VITE_API_BASE_URL=${API_BASE_URL}
VITE_API_TIMEOUT=30000

# WebSocket 配置
VITE_WS_URL=wss://${DOMAIN}/ws
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# 服务端口配置（使用反向代理）
VITE_IAM_SERVICE_URL=${IAM_SERVICE_URL}
VITE_DOC_SERVICE_URL=${DOC_SERVICE_URL}
VITE_AI_SERVICE_URL=${AI_SERVICE_URL}
VITE_FLOW_SERVICE_URL=${FLOW_SERVICE_URL}
VITE_EHS_SERVICE_URL=${EHS_SERVICE_URL}
VITE_LIMS_SERVICE_URL=${LIMS_SERVICE_URL}
VITE_PDM_SERVICE_URL=${PDM_SERVICE_URL}
VITE_QMS_SERVICE_URL=${QMS_SERVICE_URL}
VITE_MES_SERVICE_URL=${MES_SERVICE_URL}
VITE_RS_SERVICE_URL=${RS_SERVICE_URL}
VITE_SRM_SERVICE_URL=${SRM_SERVICE_URL}
VITE_ERP_SERVICE_URL=${ERP_SERVICE_URL}
VITE_SCM_SERVICE_URL=${SCM_SERVICE_URL}
VITE_WMS_SERVICE_URL=${WMS_SERVICE_URL}
VITE_CRM_SERVICE_URL=${CRM_SERVICE_URL}
VITE_HRM_SERVICE_URL=${HRM_SERVICE_URL}
VITE_GIS_SERVICE_URL=${GIS_SERVICE_URL}
VITE_BI_SERVICE_URL=${BI_SERVICE_URL}
VITE_IM_SERVICE_URL=${IM_SERVICE_URL}
VITE_MOBILE_SERVICE_URL=${MOBILE_SERVICE_URL}
VITE_INTEGRATION_SERVICE_URL=${INTEGRATION_SERVICE_URL}
VITE_PORTAL_SERVICE_URL=${PORTAL_SERVICE_URL}
VITE_NOTIFICATION_SERVICE_URL=${NOTIFICATION_SERVICE_URL}
VITE_REPORT_SERVICE_URL=${REPORT_SERVICE_URL}

# 功能开关
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_HOT_RELOAD=false
VITE_ENABLE_API_DOCS=false
VITE_ENABLE_MOCK_DATA=false

# OAuth 配置
VITE_OAUTH_GITHUB_ENABLED=${OAUTH_GITHUB_ENABLED}
VITE_OAUTH_GOOGLE_ENABLED=${OAUTH_GOOGLE_ENABLED}

# AI 配置
VITE_OLLAMA_BASE_URL=${OLLAMA_BASE_URL}
VITE_OLLAMA_MODEL=${OLLAMA_MODEL}

# 文件上传配置
VITE_MAX_UPLOAD_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip

# 日志配置
VITE_LOG_LEVEL=info
VITE_ENABLE_ERROR_TRACKING=true

# 主题配置
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# 国际化配置
VITE_DEFAULT_LOCALE=zh-CN
VITE_FALLBACK_LOCALE=en-US
VITE_SUPPORTED_LOCALES=zh-CN,en-US,ja-JP

# 性能配置
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ID=${ANALYTICS_ID}
VITE_VISUALIZATION_LIBRARY=d3

# 安全配置
VITE_CSRF_TOKEN_URL=/api/csrf-token
VITE_SESSION_TIMEOUT=60

# 第三方服务
VITE_SENTRY_DSN=${SENTRY_DSN}
VITE_GA_TRACKING_ID=${GA_TRACKING_ID}
