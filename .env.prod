# TOPEMS Production Environment Configuration
# Copy this file to .env and modify for production

# Database Configuration
DB_USER=topems
DB_PASSWORD=your_secure_password_here_change_in_production
DB_NAME=topems
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here_change_in_production
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=TOPEMS System

# Monitoring Configuration
GRAFANA_PASSWORD=your_grafana_admin_password

# Application Configuration
APP_ENV=production
RUST_LOG=info

# Frontend Configuration
API_BASE_URL=/api
